#!/usr/bin/env bash
set -euo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
generated=$here/.generated
prefix=ndp64lab
label="org.ndp64lab.owner=$prefix"
builder=ndp64labbuilder
router_image=ndp64labrouter:24.10.4
peer_image=ndp64labpeer:3.20
debian_image=ndp64labclient:trixie
alpine_image=ndp64labclient:alpine
fw3_image=ndp64labclient:21.02.7
fw4_image=ndp64labclient:25.12.6
fw3_base=openwrt/rootfs:x86-64-21.02.7@sha256:7fc2353153c65d64a35a5fb4dc21a15bb048d812c19df3d8d4ea97745349ef79
fw4_base=openwrt/rootfs:x86-64-25.12.6@sha256:14401c04218c2e0da0448f099710ada2460636a92395f353351cc616cf3f67af

# Container suffix, LAN, host octet, and native network manager.
clients() {
  local index=0 name lan host
  local -a kinds=(networkd networkmanager alpine fw3 fw4)
  for name in client{1..8} client1b; do
    lan=${name#client}; host=10
    if [[ $lan == 1b ]]; then lan=1; host=11; fi
    printf '%s %s %s %s\n' "$name" "$lan" "$host" "${kinds[index % 5]}"
    index=$((index + 1))
  done
}
client_manifest() {
  printf 'images %s %s %s %s\n' "$debian_image" "$alpine_image" "$fw3_image" "$fw4_image"
  clients
}
prepare_clients() {
  local name lan host kind config
  while read -r name lan host kind; do
    mkdir -p "$generated/clients/$name"
    config=$generated/clients/$name/network
    case $kind in
      networkd)
        cat > "$config" <<EOF
[Match]
Name=eth0
[Network]
Address=192.168.$lan.$host/24
Gateway=192.168.$lan.1
DHCP=no
IPv6AcceptRA=yes
IPv6PrivacyExtensions=no
LinkLocalAddressing=ipv6
[IPv6AcceptRA]
Token=eui64
UseDNS=no
EOF
        ;;
      networkmanager)
        cat > "$config" <<EOF
[connection]
id=lab
type=ethernet
interface-name=eth0
autoconnect=true
[ipv4]
method=manual
address1=192.168.$lan.$host/24,192.168.$lan.1
[ipv6]
method=auto
addr-gen-mode=eui64
ip6-privacy=0
ignore-auto-dns=true
EOF
        ;;
      alpine)
        cat > "$config" <<EOF
auto lo
iface lo inet loopback
auto eth0
iface eth0 inet static
    address 192.168.$lan.$host/24
    gateway 192.168.$lan.1
    pre-up sysctl -w net.ipv6.conf.eth0.accept_ra=1 net.ipv6.conf.eth0.autoconf=1 net.ipv6.conf.eth0.addr_gen_mode=0
EOF
        ;;
      fw3|fw4)
        cat > "$config" <<EOF
config interface 'loopback'
    option device 'lo'
    option ifname 'lo'
    option proto 'static'
    option ipaddr '127.0.0.1'
    option netmask '255.0.0.0'
config interface 'lan'
    option device 'eth0'
    option ifname 'eth0'
    option proto 'static'
    option ipaddr '192.168.$lan.$host'
    option netmask '255.255.255.0'
    option gateway '192.168.$lan.1'
config interface 'lan6'
    option device '@lan'
    option ifname '@lan'
    option proto 'dhcpv6'
    option reqaddress 'none'
    option reqprefix 'no'
    option delegate '0'
    option peerdns '0'
EOF
        cat > "$generated/clients/$name/firewall" <<'EOF'
config defaults
    option input 'ACCEPT'
    option output 'ACCEPT'
    option forward 'REJECT'
config zone
    option name 'lan'
    list network 'lan'
    list network 'lan6'
    option input 'ACCEPT'
    option output 'ACCEPT'
    option forward 'REJECT'
EOF
        ;;
    esac
  done < <(clients)
  client_manifest > "$generated/client-manifest"
}

die() { printf 'lab: %s\n' "$*" >&2; exit 1; }
note() { printf 'lab: %s\n' "$*" >&2; }
require_no_args() { (( $# == 0 )) || die "$applet takes no arguments"; }
container() { printf '%s%s' "$prefix" "$1"; }
network() { printf '%s%s' "$prefix" "$1"; }
dc() { docker exec "$(container "$1")" "${@:2}"; }
router_mac_matches() { [[ $(dc router cat "/sys/class/net/eth$1/address" 2>/dev/null) == "$2" ]]; }
require_tools() {
  [[ $(uname -sm) == 'Linux x86_64' ]] || die 'requires Linux x86_64'
  command -v docker >/dev/null || die 'missing docker'
  docker info >/dev/null || die 'Docker Engine is unavailable'
  local component version
  for component in Client Server; do
    version=$(docker version --format "{{.$component.Version}}")
    [[ $version =~ ^([0-9]+)\. ]] && (( BASH_REMATCH[1] >= 28 )) || die "Docker $component 28 or newer is required for interface naming"
  done
  docker buildx version >/dev/null || die 'Docker buildx is unavailable'
}
# Only this table in the Topology section supplies address naming seeds.
load_addresses() {
  local key seed stem4 stem6
  local -A seeds=()
  while IFS=' ' read -r key seed; do
    [[ $key == customer || $key == public ]] || die "unknown address key: $key"
    [[ ! -v seeds[$key] ]] || die "duplicate address key: $key"
    [[ $seed =~ ^[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ]{3}$ ]] || die "address seed $key must contain three ASCII letters"
    seeds[$key]=$seed
  done < <(LC_ALL=C awk '
    /^## Topology$/ {topology=1; next}
    topology && /^## / {exit}
    topology && /^\| `address-seed:/ {
      gsub(/`/, "", $2); gsub(/address-seed:/, "", $2)
      gsub(/`/, "", $3); print $2, $3
    }' FS='|' "$here/README.md")
  for key in customer public; do
    [[ -v seeds[$key] ]] || die "missing address-seed:$key in README Topology table"
    seed=${seeds[$key]}
    LC_ALL=C printf -v stem4 '%d.%d.%d' "'${seed:0:1}" "'${seed:1:1}" "'${seed:2:1}"
    LC_ALL=C printf -v stem6 '2%03d:%d:%d' "'${seed:0:1}" "'${seed:1:1}" "'${seed:2:1}"
    if [[ $key == customer ]]; then customer4=$stem4; customer6=$stem6
    else public4=$stem4; public6=$stem6; fi
  done
  [[ $customer4 != "$public4" ]] || die 'customer and public seeds must differ'
  isp_identity4=$customer4.1
  isp_customer4=$customer4.100
  router4=$customer4.101
  isp_dmz4=$customer4.200
  dmz4=$customer4.201
  isp_public4=$public4.1
  website4=$public4.2
  shared6=$customer6:100::
  isp_customer6=${shared6}1
  router6=${shared6}2
  isp_dmz6=$customer6:200::1
  dmz6=$customer6:200::2
  isp_public6=$public6::1
  website6=$public6::2
}
# Match Docker's historical IPv4-based MAC formula, using intended lab addresses.
mac_from_ipv4() {
  local address=$1 octet
  local -a octets=()
  [[ $address =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "invalid IPv4 address: $address"
  IFS=. read -r -a octets <<< "$address"
  for octet in "${octets[@]}"; do
    [[ ${#octet} -le 3 ]] && (( 10#$octet <= 255 )) || die "invalid IPv4 address: $address"
  done
  printf '02:42:%02x:%02x:%02x:%02x' "$((10#${octets[0]}))" "$((10#${octets[1]}))" \
    "$((10#${octets[2]}))" "$((10#${octets[3]}))"
}
# One row per Ethernet endpoint: container suffix, interface, intended IPv4.
interface_addresses() {
  printf '%s\n' "isp eth0 $isp_customer4" "isp eth1 $isp_public4" "isp eth2 $isp_dmz4" \
    "router eth0 $router4" "website eth0 $website4" "dmz eth0 $dmz4"
  local n
  for n in {1..8}; do
    printf '%s\n' "router eth$n 192.168.$n.1" "client$n eth0 192.168.$n.10"
  done
  printf '%s\n' 'client1b eth0 192.168.1.11'
}
endpoint_network() {
  printf 'name=%s,mac-address=%s,driver-opt=com.docker.network.endpoint.ifname=%s' \
    "$(network "$1")" "$(mac_from_ipv4 "$3")" "$2"
}
check_interface_macs() {
  local name interface address expected actual
  while read -r name interface address; do
    expected=$(mac_from_ipv4 "$address")
    actual=$(dc "$name" cat "/sys/class/net/$interface/address" 2>/dev/null) || actual=missing
    [[ $actual == "$expected" ]] || die "$name $interface MAC is $actual; expected $expected from $address; run ./lab reset"
  done < <(interface_addresses)
  note 'all 23 interface MACs match their IPv4 addresses'
}
address_manifest() {
  printf 'shared6=%s\nisp_customer6=%s\nwebsite4=%s\nwebsite6=%s\n' \
    "$shared6" "$isp_customer6" "$website4" "$website6"
}
prepare_configuration() {
  mkdir -p "$generated/www"
  # No new payload until a new deployment; test/up on an existing lab never rewrites it.
  # A finite random input avoids SIGPIPE under pipefail. Base64 is printable ASCII.
  head -c 3072 /dev/urandom | base64 | tr -d '\n' > "$generated/www/index.html"
  [[ $(wc -c < "$generated/www/index.html") == 4096 ]] || die 'payload generation failed'
  printf '.html:text/plain\n' > "$generated/www/httpd.conf"
  address_manifest > "$generated/addresses"
  prepare_clients
  sed -e "s/@ROUTER4@/$router4/g" -e "s/@GATEWAY4@/$isp_customer4/g" \
      -e "s/@ROUTER6@/$router6/g" "$here/router/network" > "$generated/network"
}
owned_container() {
  [[ $(docker inspect -f '{{index .Config.Labels "org.ndp64lab.owner"}}' "$1" 2>/dev/null) == "$prefix" ]]
}
owned_network() {
  [[ $(docker network inspect -f '{{index .Labels "org.ndp64lab.owner"}}' "$1" 2>/dev/null) == "$prefix" ]]
}
check_name_free() {
  local name=$1
  if docker container inspect "$name" >/dev/null 2>&1; then
    owned_container "$name" || die "container name $name belongs to another owner"
    die "lab already exists; run ./lab reset"
  fi
}
check_image_owned_or_free() {
  local owner
  owner=$(docker image inspect -f '{{index .Config.Labels "org.ndp64lab.owner"}}' "$1" 2>/dev/null) || return 0
  [[ $owner == "$prefix" ]] || die "image tag $1 belongs to another owner"
}
wait_for() {
  local description=$1 command=$2 deadline=$((SECONDS + 60))
  until eval "$command" >/dev/null 2>&1; do
    (( SECONDS < deadline )) || die "timed out waiting for $description"
    sleep 1
  done
}
build_images() {
  mkdir -p "$generated"
  if [[ ! -e "$generated/builder-owned" ]]; then
    docker buildx inspect "$builder" >/dev/null 2>&1 && die "builder $builder exists without ownership marker"
    touch "$generated/builder-owned"
    docker buildx create --name "$builder" --driver docker-container >/dev/null
  fi
  docker buildx build --builder "$builder" --load --build-arg "LAB_ID=$prefix" -f "$here/Dockerfile.peer" -t "$peer_image" "$here"
  docker buildx build --builder "$builder" --load --build-arg "LAB_ID=$prefix" -f "$here/Dockerfile.router" -t "$router_image" "$here"
  docker buildx build --builder "$builder" --load --build-arg "LAB_ID=$prefix" -f "$here/Dockerfile.client-debian" -t "$debian_image" "$here"
  docker buildx build --builder "$builder" --load --build-arg "LAB_ID=$prefix" -f "$here/Dockerfile.client-alpine" -t "$alpine_image" "$here"
  docker buildx build --builder "$builder" --load --build-arg "LAB_ID=$prefix" --build-arg "OPENWRT_IMAGE=$fw3_base" -f "$here/Dockerfile.client-openwrt" -t "$fw3_image" "$here"
  docker buildx build --builder "$builder" --load --build-arg "LAB_ID=$prefix" --build-arg "OPENWRT_IMAGE=$fw4_base" -f "$here/Dockerfile.client-openwrt" -t "$fw4_image" "$here"
}
create_networks() {
  local segment
  for segment in wan public dmz {1..8}; do
    local name; name=$(network "$segment")
    docker network inspect "$name" >/dev/null 2>&1 && die "network $name already exists"
    docker network create --internal --driver bridge --label "$label" "$name" >/dev/null
  done
}
prepare_firewall3() {
  # Legacy firewall3 needs host-kernel xtables modules before procd starts it.
  if [[ ! -d /sys/module/iptable_filter || ! -d /sys/module/ip6table_filter ]]; then
    [[ -d /lib/modules/$(uname -r) ]] || die 'firewall3 requires host iptable_filter and ip6table_filter modules'
    printf 'iptable_filter\nip6table_filter\n' > "$generated/firewall3-modules.conf"
    docker run --rm --privileged --network none --label "$label" \
      --volume /lib/modules:/lib/modules:ro \
      --volume "$generated/firewall3-modules.conf:/etc/modules-load.d/lab.conf:ro" \
      "$debian_image" /lib/systemd/systemd-modules-load
  fi
}
start_peers() {
  docker run -d --privileged --name "$(container isp)" --label "$label" \
    --network "$(endpoint_network wan eth0 "$isp_customer4")" \
    --network "$(endpoint_network public eth1 "$isp_public4")" \
    --network "$(endpoint_network dmz eth2 "$isp_dmz4")" "$peer_image" >/dev/null
  docker run -d --privileged --name "$(container dmz)" --label "$label" \
    --network "$(endpoint_network dmz eth0 "$dmz4")" "$peer_image" >/dev/null
  docker run -d --privileged --name "$(container website)" --label "$label" \
    --volume "$generated/www:/www:ro" --network "$(endpoint_network public eth0 "$website4")" "$peer_image" \
    httpd -f -p 80 -h /www >/dev/null
  start_clients
}
start_clients() {
  local name lan host kind image
  local -a options
  while read -r name lan host kind; do
    options=()
    case $kind in
      networkd|networkmanager)
        image=$debian_image
        options+=(--cgroupns private --tmpfs /run --tmpfs /run/lock --tmpfs /tmp --env container=docker)
        ;;
      alpine) image=$alpine_image ;;
      fw3) image=$fw3_image ;;
      fw4) image=$fw4_image ;;
    esac
    docker run -d --privileged --name "$(container "$name")" --label "$label" \
      --env "LAB_CLIENT_KIND=$kind" --volume "$generated/clients/$name:/lab-client:ro" \
      "${options[@]}" --network "$(endpoint_network "$lan" eth0 "192.168.$lan.$host")" "$image" >/dev/null
  done < <(clients)
}
start_router() {
  local n mac
  local -a networks=(--network "$(endpoint_network wan eth0 "$router4")")
  : > "$generated/interfaces.tmp"
  printf '0 %s\n' "$(mac_from_ipv4 "$router4")" >> "$generated/interfaces.tmp"
  for n in {1..8}; do
    networks+=(--network "$(endpoint_network "$n" "eth$n" "192.168.$n.1"),alias=router$n")
    printf '%s %s\n' "$n" "$(mac_from_ipv4 "192.168.$n.1")" >> "$generated/interfaces.tmp"
  done
  mv "$generated/interfaces.tmp" "$generated/interfaces"
  docker create --privileged --name "$(container router)" --label "$label" \
    --volume "$generated:/lab:ro" "${networks[@]}" "$router_image" >/dev/null
  docker start "$(container router)" >/dev/null
  for n in {0..8}; do
    mac=$(awk -v n="$n" '$1 == n {print $2}' "$generated/interfaces")
    wait_for "router eth$n MAC $mac" "router_mac_matches $n $mac"
  done
  wait_for 'OpenWrt helper' 'dc router pidof lab-ndp'
  wait_for 'OpenWrt firewall' 'dc router nft list table inet fw4'
}
configure_peers() {
  local name port
  for port in eth0 eth1 eth2; do
    dc isp ip -4 addr flush dev "$port"
    dc isp sysctl -w "net.ipv6.conf.$port.disable_ipv6=0" >/dev/null
  done
  dc isp sysctl -w net.ipv4.ip_forward=1 net.ipv6.conf.all.forwarding=1 >/dev/null
  dc isp ip -4 addr add "$isp_identity4/32" dev lo
  dc isp ip -4 addr add "$isp_customer4/31" dev eth0
  dc isp ip -6 addr add fe80::1/64 dev eth0
  dc isp ip -6 addr add "$isp_customer6/128" dev eth0
  dc isp ip -4 addr add "$isp_public4/30" dev eth1
  dc isp ip -6 addr add "$isp_public6/64" dev eth1
  dc isp ip -4 addr add "$isp_dmz4/31" dev eth2
  dc isp ip -6 addr add "$isp_dmz6/128" dev eth2
  [[ $(dc isp ip -6 route show root "$shared6/64" dev eth0 | awk '{print $1}') == "$isp_customer6" ]] || die 'ISP starts with unexpected customer routes'
  [[ $(dc isp ip -6 route show root "$customer6:200::/64" dev eth2 | awk '{print $1}') == "$isp_dmz6" ]] || die 'ISP starts with unexpected DMZ routes'
  docker exec -d "$(container isp)" sh -c 'exec /usr/sbin/lab-ndp isp "$1" "$2" eth0 >/tmp/isp-learning-eth0.log 2>&1' sh "$shared6/64" "$isp_customer6"
  docker exec -d "$(container isp)" sh -c 'exec /usr/sbin/lab-ndp isp "$1" "$2" eth2 >/tmp/isp-learning-eth2.log 2>&1' sh "$customer6:200::/64" "$isp_dmz6"
  wait_for 'ISP NS learners' '[[ $(dc isp pidof lab-ndp | wc -w) -eq 2 ]]'
  for name in dmz website; do
    dc "$name" ip -4 addr flush dev eth0
    dc "$name" sysctl -w net.ipv6.conf.eth0.disable_ipv6=0 >/dev/null
    if [[ $name == dmz ]]; then
      dc "$name" ip -4 addr add "$dmz4/31" dev eth0
      dc "$name" ip -6 addr add "$dmz6/64" dev eth0
      dc "$name" ip -4 route replace default via "$isp_dmz4"
      dc "$name" ip -6 route replace default via "$isp_dmz6"
    else
      dc "$name" ip -4 addr add "$website4/30" dev eth0
      dc "$name" ip -6 addr add "$website6/64" dev eth0
      dc "$name" ip -4 route replace default via "$isp_public4"
      dc "$name" ip -6 route replace default via "$isp_public6"
    fi
  done
}
do_up() {
  load_addresses
  require_tools
  local name
  for name in isp router website dmz client{1..8} client1b; do check_name_free "$(container "$name")"; done
  for name in "$router_image" "$peer_image" "$debian_image" "$alpine_image" "$fw3_image" "$fw4_image"; do
    check_image_owned_or_free "$name"
  done
  prepare_configuration
  build_images
  create_networks
  prepare_firewall3
  start_peers
  configure_peers
  start_router
  wait_for 'native client managers' 'check_client_managers'
  note 'lab is up'
}
do_purge() {
  require_tools
  local resource
  while IFS= read -r resource; do [[ -z $resource ]] || docker rm -f "$resource" >/dev/null; done < <(docker ps -aq --filter "label=$label")
  while IFS= read -r resource; do [[ -z $resource ]] || docker network rm "$resource" >/dev/null; done < <(docker network ls -q --filter "label=$label")
  while IFS= read -r resource; do [[ -z $resource ]] || docker image rm -f "$resource" >/dev/null; done < <(docker image ls -q --filter "label=$label" | sort -u)
  if [[ -e "$generated/builder-owned" ]]; then
    docker buildx prune --builder "$builder" --all --force >/dev/null 2>&1 || true
    docker buildx rm "$builder" >/dev/null 2>&1 || true
  fi
  [[ ! -e "$generated" ]] || rm -rf -- "$generated"
  note 'lab resources removed'
}
client_addr() {
  dc "$1" ip -o -6 addr show dev eth0 scope global | awk -v prefix="$shared6" 'index($4, substr(prefix, 1, length(prefix)-1)) == 1 && !/tentative|dadfailed/ {split($4,a,"/"); print a[1]; exit}'
}
assert_contains() { [[ $1 == *"$2"* ]] || die "expected '$2' in: $1"; }
check_website() {
  local name=$1 target response
  [[ $(wc -c < "$generated/www/index.html") == 4096 ]] || die 'invalid deployment payload size'
  LC_ALL=C tr -d ' -~' < "$generated/www/index.html" | cmp -s - /dev/null || die 'non-printable deployment payload'
  response=$(mktemp "$generated/http.XXXXXX")
  for target in "$website4" "[$website6]"; do
    # Curl fails on HTTP errors; cmp compares every byte, including trailing newlines.
    if ! dc "$name" curl --noproxy '*' --fail --silent --show-error --max-time 5 "http://$target/" > "$response"; then
      rm -f "$response"
      die "$name HTTP request to $target failed"
    fi
    if ! cmp -s "$response" "$generated/www/index.html"; then
      rm -f "$response"
      die "$name HTTP body from $target differs from deployment payload"
    fi
  done
  rm -f "$response"
}
check_isp_ns_learning() {
  local probe=$customer6:200::1234
  # Clear a previous interrupted check, then force data traffic without NS.
  dc dmz ip -6 addr del "$probe/128" dev eth0 >/dev/null 2>&1 || true
  dc isp ip -6 route del "$probe/128" dev eth2 >/dev/null 2>&1 || true
  dc isp ip -6 neigh del "$probe" dev eth2 >/dev/null 2>&1 || true
  dc dmz ip -6 addr add "$probe/128" dev eth0 nodad
  dc dmz ip -6 neigh replace "$isp_dmz6" lladdr "$(mac_from_ipv4 "$isp_dmz4")" nud permanent dev eth0
  if dc dmz ping -6 -I "$probe" -c 1 -W 1 "$website6" >/dev/null 2>&1; then
    die 'ISP returned traffic to a source that never sent NS'
  fi
  [[ -z $(dc isp ip -6 route show exact "$probe/128") ]] || die 'ISP learned a route from ordinary traffic'
  [[ -z $(dc isp ip -6 neigh show "$probe" dev eth2) ]] || die 'ISP learned a neighbor from ordinary traffic'
  # Force a real gateway NS using the probe as its source, then check both tables.
  dc dmz ip -6 neigh del "$isp_dmz6" dev eth0
  wait_for 'DMZ probe NS registration' "dc dmz ping -6 -I $probe -c 1 -W 2 $website6"
  assert_contains "$(dc isp ip -6 route show exact "$probe/128")" "$probe dev eth2"
  assert_contains "$(dc isp ip -6 neigh show "$probe" dev eth2)" "$(mac_from_ipv4 "$dmz4")"
  dc dmz ip -6 addr del "$probe/128" dev eth0
  dc isp ip -6 route del "$probe/128" dev eth2
  dc isp ip -6 neigh del "$probe" dev eth2
  note 'ISP ignores ordinary sources and learns route/neighbor from NS'
}
check_client_managers() {
  local name lan host kind
  while read -r name lan host kind; do
    [[ $(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$(container "$name")") == *"LAB_CLIENT_KIND=$kind"* ]] || die "$name has wrong client kind; run ./lab reset"
    case $kind in
      networkd) dc "$name" systemctl is-active --quiet systemd-networkd || return 1 ;;
      networkmanager)
        dc "$name" systemctl is-active --quiet NetworkManager || return 1
        [[ $(dc "$name" nmcli -g GENERAL.CONNECTION device show eth0) == lab ]] || return 1
        ;;
      alpine) dc "$name" ifquery --state eth0 >/dev/null || return 1 ;;
      fw3)
        dc "$name" pidof netifd >/dev/null || return 1
        dc "$name" iptables -S zone_lan_input >/dev/null || return 1
        dc "$name" ip6tables -S zone_lan_input >/dev/null || return 1
        dc "$name" fw3 print >/dev/null 2>&1 || return 1
        ;;
      fw4)
        dc "$name" pidof netifd >/dev/null || return 1
        dc "$name" nft list table inet fw4 >/dev/null || return 1
        ;;
    esac
    [[ $(dc "$name" ip -o -4 addr show dev eth0) == *"inet 192.168.$lan.$host/24"* ]] || return 1
    note "$name uses $kind"
  done < <(clients)
}
do_test() {
  load_addresses
  require_tools
  owned_container "$(container router)" || die 'lab is not up'
  [[ $(cat "$generated/addresses") == "$(address_manifest)" ]] || die 'README address seeds changed; run ./lab reset'
  [[ -f $generated/client-manifest && $(cat "$generated/client-manifest") == "$(client_manifest)" ]] || die 'client mix changed; run ./lab reset'
  check_client_managers || die 'a native client manager or firewall is unavailable'
  check_interface_macs
  local n peer name addr addr1 addr1b peer_mac route neigh proxy_table global_addrs unknown_route
  assert_contains "$(dc isp ip -o -6 addr show dev eth0 scope global)" "$isp_customer6/128"
  assert_contains "$(dc isp ip -o -6 addr show dev eth2 scope global)" "$isp_dmz6/128"
  if unknown_route=$(dc isp ip -6 route get "${shared6}dead:beef" 2>&1); then
    die "ISP has a route to an unseen customer: $unknown_route; run ./lab reset"
  fi
  if unknown_route=$(dc isp ip -6 route get "$customer6:200::dead:beef" 2>&1); then
    die "ISP has a route to an unseen DMZ client: $unknown_route; run ./lab reset"
  fi
  wait_for 'DMZ NS registration and ISP connectivity' "dc dmz ping -6 -c 1 -W 2 $isp_dmz6"
  assert_contains "$(dc isp ip -6 route show exact "$dmz6/128")" "$dmz6 dev eth2"
  assert_contains "$(dc isp ip -6 neigh show "$dmz6" dev eth2)" "$(mac_from_ipv4 "$dmz4")"
  check_isp_ns_learning
  assert_contains "$(dc router ip -6 route get "$isp_customer6")" 'via fe80::1 dev eth0'
  wait_for 'router ISP on-link connectivity' "dc router ping -6 -c 1 -W 2 $isp_customer6"
  if unknown_route=$(dc router ip -6 route get "${shared6}dead:beef" 2>&1); then
    die "unknown shared-prefix address routes via WAN: $unknown_route"
  fi
  assert_contains "$unknown_route" 'unreachable'
  if dc router ping -6 -c 1 -W 1 "${shared6}dead:beef" >/dev/null 2>&1; then
    die 'router reached an unknown shared-prefix address'
  fi
  [[ -z $(dc router ip -6 neigh show "${shared6}dead:beef" dev eth0) ]] || die 'unknown address triggered WAN neighbor discovery'
  declare -A addresses=() ipv4=() lans=()
  for name in client{1..8} client1b; do
    n=${name#client}
    if [[ $n == 1b ]]; then n=1; ipv4[$name]=192.168.1.11
    else ipv4[$name]="192.168.$n.10"; fi
    lans[$name]=$n
    [[ $(dc router uci -q get "dhcp.lan$n.dhcpv6") == disabled ]] || die "DHCPv6 is enabled on LAN$n"
    wait_for "$name SLAAC" "[[ -n \$(client_addr $name) ]]"
    global_addrs=$(dc "$name" ip -o -6 addr show dev eth0 scope global)
    [[ $(printf '%s\n' "$global_addrs" | wc -l) -eq 1 && $global_addrs != *temporary* ]] || die "$name has unexpected global IPv6 addresses: $global_addrs"
    addr=$(client_addr "$name")
    addresses[$name]=$addr
    assert_contains "$(dc "$name" ip -4 route get "$isp_identity4")" "via 192.168.$n.1"
    dc "$name" ping -4 -c 1 -W 2 "$isp_identity4" >/dev/null || die "$name cannot reach WAN over IPv4"
    wait_for "$name IPv6 WAN connectivity" "dc $name ping -6 -I $addr -c 1 -W 2 ${dmz6}"
    wait_for "$name ISP on-link connectivity" "dc $name ping -6 -I $addr -c 1 -W 2 ${isp_customer6}"
    wait_for "$name route installation" "dc router ip -6 route get $addr | grep -q 'dev eth$n'"
    assert_contains "$(dc isp ip -6 route show exact "$addr/128")" "$addr dev eth0"
    assert_contains "$(dc isp ip -6 neigh show "$addr" dev eth0)" "$(mac_from_ipv4 "$router4")"
    dc isp ping -6 -c 1 -W 2 "$addr" >/dev/null || die "ISP cannot reach $name"
    assert_contains "$(dc router ip -6 neigh show proxy dev eth0)" "$addr"
    dc dmz ping -6 -c 1 -W 2 "$addr" >/dev/null || die "DMZ cannot reach $name"
    check_website "$name"
    note "$name IPv4/IPv6 WAN, DMZ, HTTP content and upstream NDP passed"
  done
  proxy_table=$(dc router ip -6 neigh show proxy)
  for name in client{1..8} client1b; do
    n=${lans[$name]}
    addr=${addresses[$name]}
    for peer in {0..8}; do
      if (( peer == n )); then
        [[ $proxy_table != *"$addr dev eth$peer proxy"* ]] || die "$name is proxied on its own LAN"
      else
        assert_contains "$proxy_table" "$addr dev eth$peer proxy"
      fi
    done
    assert_contains "$proxy_table" "${isp_customer6} dev eth$n proxy"
  done
  for name in client{1..8} client1b; do
    for peer in client{1..8} client1b; do
      [[ ${lans[$name]} == "${lans[$peer]}" ]] && continue
      dc "$name" ping -4 -c 1 -W 2 "${ipv4[$peer]}" >/dev/null || die "$name cannot reach $peer over IPv4"
      dc "$name" ping -6 -c 1 -W 2 "${addresses[$peer]}" >/dev/null || die "$name cannot reach $peer over IPv6"
    done
  done
  note 'all cross-LAN IPv4 and IPv6 pairs passed'
  addr1=${addresses[client1]}
  addr1b=${addresses[client1b]}
  dc client1b ping -6 -c 2 -W 2 "$addr1" >/dev/null || die 'LAN1 peers cannot communicate'
  dc router nft delete table inet ndp64labcheck >/dev/null 2>&1 || true
  dc router nft add table inet ndp64labcheck
  dc router nft add chain inet ndp64labcheck forward '{ type filter hook forward priority 10; policy accept; }'
  dc router nft add rule inet ndp64labcheck forward ip6 saddr "$addr1" ip6 daddr "$addr1b" counter
  dc router nft add rule inet ndp64labcheck forward ip6 saddr "$addr1b" ip6 daddr "$addr1" counter
  for name in client1 client1b; do
    if [[ $name == client1 ]]; then addr=$addr1b; peer_mac=$(mac_from_ipv4 192.168.1.11); else addr=$addr1; peer_mac=$(mac_from_ipv4 192.168.1.10); fi
    route=$(dc "$name" ip -6 route get "$addr")
    assert_contains "$route" 'dev eth0'
    [[ $route != *'via '* ]] || die "$name routes its LAN1 peer through a gateway"
    dc "$name" ping -6 -c 1 -W 2 "$addr" >/dev/null
    neigh=$(dc "$name" ip -6 neigh show "$addr" dev eth0)
    assert_contains "$neigh" "$peer_mac"
  done
  if dc router nft list chain inet ndp64labcheck forward | grep -Eq 'counter packets [1-9]'; then
    die 'LAN1 peer traffic entered the router forwarding path'
  fi
  assert_contains "$(dc router ip -6 route get "$addr1")" 'dev eth1'
  assert_contains "$(dc router ip -6 route get "${addresses[client2]}")" 'dev eth2'
  dc client1 ping -6 -I "$addr1" -c 2 -W 2 "$dmz6" >/dev/null || die 'explicit source address failed'
  dc router nft add rule inet ndp64labcheck forward iifname eth0 ip6 daddr "$addr1" tcp dport 12345 counter
  # Prove a service is listening before checking the firewall; a closed port
  # or unsupported nc option must not make this test pass.
  dc client1 sh -c 'mkdir -p /tmp/inbound; printf inbound > /tmp/inbound/index.html; python3 -m http.server 12345 --bind :: --directory /tmp/inbound >/tmp/inbound.log 2>&1 & echo $! >/tmp/inbound.pid'
  wait_for 'inbound test listener' "dc client1 curl --noproxy '*' --fail --silent --max-time 2 'http://[::1]:12345/'"
  [[ $(dc client1 curl --noproxy '*' --fail --silent --max-time 2 'http://[::1]:12345/') == inbound ]] || die 'inbound test listener is unavailable'
  for name in isp dmz; do
    if dc "$name" curl --noproxy '*' --fail --silent --max-time 2 "http://[$addr1]:12345/" >/dev/null 2>&1; then
      die "new inbound TCP from $name unexpectedly connected"
    fi
  done
  dc client1 sh -c 'kill $(cat /tmp/inbound.pid)'
  if dc router nft list chain inet ndp64labcheck forward | grep -Eq 'tcp dport 12345 counter packets [1-9]'; then
    die 'new inbound TCP passed the WAN firewall'
  fi
  dc router nft delete table inet ndp64labcheck
  check_website dmz
  note 'all acceptance checks passed'
}

up_applet() { require_no_args "$@"; do_up; }
test_applet() { require_no_args "$@"; do_test; }
purge_applet() { require_no_args "$@"; do_purge; }
reset_applet() { require_no_args "$@"; do_purge; do_up; do_test; }
exec_applet() {
  (( $# > 0 )) || die 'usage: ./lab exec <container suffix> [command [arguments...]]'
  local suffix=$1
  shift
  if (( $# > 0 )); then
    dc "$suffix" "$@"
  else
    docker exec -it "$(container "$suffix")" /bin/sh
  fi
}

# Allow the address generator to be exercised without Docker.
if [[ ${BASH_SOURCE[0]} != "$0" ]]; then return 0; fi

(( $# > 0 )) || die 'usage: ./lab {up|test|purge|reset|exec}'
applet=$1; shift
case "$applet" in
  up) up_applet "$@" ;;
  test) test_applet "$@" ;;
  purge) purge_applet "$@" ;;
  reset) reset_applet "$@" ;;
  exec) exec_applet "$@" ;;
  *) die "unknown applet: $applet" ;;
esac
