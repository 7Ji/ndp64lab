#!/usr/bin/env bash
set -euo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
generated=$here/.generated
prefix=ndp64lab
label="org.ndp64lab.owner=$prefix"
builder=ndp64labbuilder
router_image=ndp64labrouter:24.10.4
peer_image=ndp64labpeer:3.20

die() { printf 'lab: %s\n' "$*" >&2; exit 1; }
note() { printf 'lab: %s\n' "$*" >&2; }
require_no_args() { (( $# == 0 )) || die "$applet takes no arguments"; }
container() { printf '%s%s' "$prefix" "$1"; }
network() { printf '%s%s' "$prefix" "$1"; }
dc() { docker exec "$(container "$1")" "${@:2}"; }
router_mac_matches() { [[ $(dc router cat "/sys/class/net/eth$1/address" 2>/dev/null) == "$2" ]]; }
require_tools() {
  [[ $(uname -sm) == 'Linux x86_64' ]] || die 'requires Linux x86_64'
  command -v docker >/dev/null || die 'missing docker'
  docker info >/dev/null || die 'Docker Engine is unavailable'
  docker buildx version >/dev/null || die 'Docker buildx is unavailable'
}
# Only this table in the Topology section supplies address naming seeds.
load_addresses() {
  local key seed stem4 stem6
  local -A seeds=()
  while IFS=' ' read -r key seed; do
    [[ $key == customer || $key == public ]] || die "unknown address key: $key"
    [[ ! -v seeds[$key] ]] || die "duplicate address key: $key"
    [[ $seed =~ ^[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ]{3}$ ]] || die "address seed $key must contain three ASCII letters"
    seeds[$key]=$seed
  done < <(LC_ALL=C awk '
    /^## Topology$/ {topology=1; next}
    topology && /^## / {exit}
    topology && /^\| `address-seed:/ {
      gsub(/`/, "", $2); gsub(/address-seed:/, "", $2)
      gsub(/`/, "", $3); print $2, $3
    }' FS='|' "$here/README.md")
  for key in customer public; do
    [[ -v seeds[$key] ]] || die "missing address-seed:$key in README Topology table"
    seed=${seeds[$key]}
    LC_ALL=C printf -v stem4 '%d.%d.%d' "'${seed:0:1}" "'${seed:1:1}" "'${seed:2:1}"
    LC_ALL=C printf -v stem6 '2%03d:%d:%d' "'${seed:0:1}" "'${seed:1:1}" "'${seed:2:1}"
    if [[ $key == customer ]]; then customer4=$stem4; customer6=$stem6
    else public4=$stem4; public6=$stem6; fi
  done
  [[ $customer4 != "$public4" ]] || die 'customer and public seeds must differ'
  isp_identity4=$customer4.1
  isp_customer4=$customer4.100
  router4=$customer4.101
  isp_dmz4=$customer4.200
  dmz4=$customer4.201
  isp_public4=$public4.1
  website4=$public4.2
  shared6=$customer6:100::
  isp_customer6=${shared6}1
  router6=${shared6}2
  isp_dmz6=$customer6:200::1
  dmz6=$customer6:200::2
  isp_public6=$public6::1
  website6=$public6::2
}
address_manifest() {
  printf 'shared6=%s\nisp_customer6=%s\nwebsite4=%s\nwebsite6=%s\n' \
    "$shared6" "$isp_customer6" "$website4" "$website6"
}
prepare_configuration() {
  mkdir -p "$generated/www"
  # No new payload until a new deployment; test/up on an existing lab never rewrites it.
  # A finite random input avoids SIGPIPE under pipefail. Base64 is printable ASCII.
  head -c 3072 /dev/urandom | base64 | tr -d '\n' > "$generated/www/index.html"
  [[ $(wc -c < "$generated/www/index.html") == 4096 ]] || die 'payload generation failed'
  printf '.html:text/plain\n' > "$generated/www/httpd.conf"
  address_manifest > "$generated/addresses"
  sed -e "s/@ROUTER4@/$router4/g" -e "s/@GATEWAY4@/$isp_customer4/g" \
      -e "s/@ROUTER6@/$router6/g" "$here/router/network" > "$generated/network"
}
owned_container() {
  [[ $(docker inspect -f '{{index .Config.Labels "org.ndp64lab.owner"}}' "$1" 2>/dev/null) == "$prefix" ]]
}
owned_network() {
  [[ $(docker network inspect -f '{{index .Labels "org.ndp64lab.owner"}}' "$1" 2>/dev/null) == "$prefix" ]]
}
check_name_free() {
  local name=$1
  if docker container inspect "$name" >/dev/null 2>&1; then
    owned_container "$name" || die "container name $name belongs to another owner"
    die "lab already exists; run ./lab reset"
  fi
}
check_image_owned_or_free() {
  local owner
  owner=$(docker image inspect -f '{{index .Config.Labels "org.ndp64lab.owner"}}' "$1" 2>/dev/null) || return 0
  [[ $owner == "$prefix" ]] || die "image tag $1 belongs to another owner"
}
wait_for() {
  local description=$1 command=$2 deadline=$((SECONDS + 60))
  until eval "$command" >/dev/null 2>&1; do
    (( SECONDS < deadline )) || die "timed out waiting for $description"
    sleep 1
  done
}
build_images() {
  mkdir -p "$generated"
  if [[ ! -e "$generated/builder-owned" ]]; then
    docker buildx inspect "$builder" >/dev/null 2>&1 && die "builder $builder exists without ownership marker"
    touch "$generated/builder-owned"
    docker buildx create --name "$builder" --driver docker-container >/dev/null
  fi
  docker buildx build --builder "$builder" --load --build-arg "LAB_ID=$prefix" -f "$here/Dockerfile.peer" -t "$peer_image" "$here"
  docker buildx build --builder "$builder" --load --build-arg "LAB_ID=$prefix" -f "$here/Dockerfile.router" -t "$router_image" "$here"
}
create_networks() {
  local segment
  for segment in wan public dmz {1..8}; do
    local name; name=$(network "$segment")
    docker network inspect "$name" >/dev/null 2>&1 && die "network $name already exists"
    docker network create --internal --driver bridge --label "$label" "$name" >/dev/null
  done
}
start_peers() {
  docker run -d --privileged --name "$(container isp)" --label "$label" \
    --network "$(network wan)" --mac-address 02:42:ac:20:00:01 "$peer_image" >/dev/null
  docker network connect "$(network public)" "$(container isp)"
  docker network connect "$(network dmz)" "$(container isp)"
  docker run -d --privileged --name "$(container dmz)" --label "$label" \
    --network "$(network dmz)" "$peer_image" >/dev/null
  docker run -d --privileged --name "$(container website)" --label "$label" \
    --volume "$generated/www:/www:ro" --network "$(network public)" "$peer_image" \
    httpd -f -p 80 -h /www >/dev/null
  local n name mac
  for n in {1..8}; do
    printf -v mac '02:42:ac:10:%02x:0a' "$n"
    name="client$n"
    docker run -d --privileged --name "$(container "$name")" --label "$label" \
      --network "$(network "$n")" --mac-address "$mac" "$peer_image" >/dev/null
  done
  docker run -d --privileged --name "$(container client1b)" --label "$label" \
    --network "$(network 1)" --mac-address 02:42:ac:10:01:0b "$peer_image" >/dev/null
}
start_router() {
  docker create --privileged --name "$(container router)" --label "$label" \
    --volume "$generated:/lab:ro" \
    --network "$(network wan)" --mac-address 02:42:ac:00:00:00 "$router_image" >/dev/null
  local n mac
  for n in {1..8}; do
    docker network connect --alias "router$n" "$(network "$n")" "$(container router)"
  done
  : > "$generated/interfaces.tmp"
  docker start "$(container router)" >/dev/null
  for n in {0..8}; do
    if (( n == 0 )); then mac=$(docker inspect -f "{{(index .NetworkSettings.Networks \"$(network wan)\").MacAddress}}" "$(container router)");
    else mac=$(docker inspect -f "{{(index .NetworkSettings.Networks \"$(network "$n")\").MacAddress}}" "$(container router)"); fi
    [[ $mac =~ ^[[:xdigit:]:]{17}$ ]] || die "missing MAC for router LAN$n"
    printf '%s %s\n' "$n" "$mac" >> "$generated/interfaces.tmp"
  done
  mv "$generated/interfaces.tmp" "$generated/interfaces"
  for n in {0..8}; do
    mac=$(awk -v n="$n" '$1 == n {print $2}' "$generated/interfaces")
    wait_for "router eth$n MAC $mac" "router_mac_matches $n $mac"
  done
  wait_for 'OpenWrt helper' 'dc router pidof lab-ndp'
  wait_for 'OpenWrt firewall' 'dc router nft list table inet fw4'
}
configure_peers() {
  local n name
  local port
  for port in eth0 eth1 eth2; do
    dc isp ip -4 addr flush dev "$port"
    dc isp sysctl -w "net.ipv6.conf.$port.disable_ipv6=0" >/dev/null
  done
  dc isp sysctl -w net.ipv4.ip_forward=1 net.ipv6.conf.all.forwarding=1 >/dev/null
  dc isp ip -4 addr add "$isp_identity4/32" dev lo
  dc isp ip -4 addr add "$isp_customer4/31" dev eth0
  dc isp ip -6 addr add fe80::1/64 dev eth0
  dc isp ip -6 addr add "$isp_customer6/64" dev eth0
  dc isp ip -4 addr add "$isp_public4/30" dev eth1
  dc isp ip -6 addr add "$isp_public6/64" dev eth1
  dc isp ip -4 addr add "$isp_dmz4/31" dev eth2
  dc isp ip -6 addr add "$isp_dmz6/64" dev eth2
  for name in dmz website; do
    dc "$name" ip -4 addr flush dev eth0
    dc "$name" sysctl -w net.ipv6.conf.eth0.disable_ipv6=0 >/dev/null
    if [[ $name == dmz ]]; then
      dc "$name" ip -4 addr add "$dmz4/31" dev eth0
      dc "$name" ip -6 addr add "$dmz6/64" dev eth0
      dc "$name" ip -4 route replace default via "$isp_dmz4"
      dc "$name" ip -6 route replace default via "$isp_dmz6"
    else
      dc "$name" ip -4 addr add "$website4/30" dev eth0
      dc "$name" ip -6 addr add "$website6/64" dev eth0
      dc "$name" ip -4 route replace default via "$isp_public4"
      dc "$name" ip -6 route replace default via "$isp_public6"
    fi
  done
  for n in {1..8}; do
    name="client$n"
    dc "$name" sysctl -w net.ipv6.conf.eth0.disable_ipv6=0 >/dev/null
    dc "$name" sysctl -w net.ipv6.conf.eth0.use_tempaddr=0 >/dev/null
    dc "$name" ip -4 addr flush dev eth0
    dc "$name" ip -4 addr add "192.168.$n.10/24" dev eth0
    dc "$name" ip -4 route replace default via "192.168.$n.1" dev eth0
  done
  dc client1b sysctl -w net.ipv6.conf.eth0.disable_ipv6=0 >/dev/null
  dc client1b sysctl -w net.ipv6.conf.eth0.use_tempaddr=0 >/dev/null
  dc client1b ip -4 addr flush dev eth0
  dc client1b ip -4 addr add 192.168.1.11/24 dev eth0
  dc client1b ip -4 route replace default via 192.168.1.1 dev eth0
}
do_up() {
  load_addresses
  require_tools
  local name
  for name in isp router website dmz client{1..8} client1b; do check_name_free "$(container "$name")"; done
  check_image_owned_or_free "$router_image"
  check_image_owned_or_free "$peer_image"
  prepare_configuration
  build_images
  create_networks
  start_peers
  configure_peers
  start_router
  note 'lab is up'
}
do_purge() {
  require_tools
  local resource
  while IFS= read -r resource; do [[ -z $resource ]] || docker rm -f "$resource" >/dev/null; done < <(docker ps -aq --filter "label=$label")
  while IFS= read -r resource; do [[ -z $resource ]] || docker network rm "$resource" >/dev/null; done < <(docker network ls -q --filter "label=$label")
  while IFS= read -r resource; do [[ -z $resource ]] || docker image rm -f "$resource" >/dev/null; done < <(docker image ls -q --filter "label=$label" | sort -u)
  if [[ -e "$generated/builder-owned" ]]; then
    docker buildx prune --builder "$builder" --all --force >/dev/null 2>&1 || true
    docker buildx rm "$builder" >/dev/null 2>&1 || true
  fi
  [[ ! -e "$generated" ]] || rm -rf -- "$generated"
  note 'lab resources removed'
}
client_addr() {
  dc "$1" ip -o -6 addr show dev eth0 scope global | awk -v prefix="$shared6" 'index($4, substr(prefix, 1, length(prefix)-1)) == 1 && /proto kernel_ra/ {split($4,a,"/"); print a[1]; exit}'
}
assert_contains() { [[ $1 == *"$2"* ]] || die "expected '$2' in: $1"; }
check_website() {
  local name=$1 target response
  [[ $(wc -c < "$generated/www/index.html") == 4096 ]] || die 'invalid deployment payload size'
  LC_ALL=C tr -d ' -~' < "$generated/www/index.html" | cmp -s - /dev/null || die 'non-printable deployment payload'
  response=$(mktemp "$generated/http.XXXXXX")
  for target in "$website4" "[$website6]"; do
    # Curl fails on HTTP errors; cmp compares every byte, including trailing newlines.
    if ! dc "$name" curl --noproxy '*' --fail --silent --show-error --max-time 5 "http://$target/" > "$response"; then
      rm -f "$response"
      die "$name HTTP request to $target failed"
    fi
    if ! cmp -s "$response" "$generated/www/index.html"; then
      rm -f "$response"
      die "$name HTTP body from $target differs from deployment payload"
    fi
  done
  rm -f "$response"
}
do_test() {
  load_addresses
  require_tools
  owned_container "$(container router)" || die 'lab is not up'
  [[ $(cat "$generated/addresses") == "$(address_manifest)" ]] || die 'README address seeds changed; run ./lab reset'
  local n peer name addr addr1 addr1b peer_mac route neigh proxy_table global_addrs unknown_route
  assert_contains "$(dc router ip -6 route get "$isp_customer6")" 'via fe80::1 dev eth0'
  wait_for 'router ISP on-link connectivity' "dc router ping -6 -c 1 -W 2 $isp_customer6"
  if unknown_route=$(dc router ip -6 route get "${shared6}dead:beef" 2>&1); then
    die "unknown shared-prefix address routes via WAN: $unknown_route"
  fi
  assert_contains "$unknown_route" 'unreachable'
  if dc router ping -6 -c 1 -W 1 "${shared6}dead:beef" >/dev/null 2>&1; then
    die 'router reached an unknown shared-prefix address'
  fi
  [[ -z $(dc router ip -6 neigh show "${shared6}dead:beef" dev eth0) ]] || die 'unknown address triggered WAN neighbor discovery'
  declare -A addresses=() ipv4=() lans=()
  for name in client{1..8} client1b; do
    n=${name#client}
    if [[ $n == 1b ]]; then n=1; ipv4[$name]=192.168.1.11
    else ipv4[$name]="192.168.$n.10"; fi
    lans[$name]=$n
    [[ $(dc router uci -q get "dhcp.lan$n.dhcpv6") == disabled ]] || die "DHCPv6 is enabled on LAN$n"
    wait_for "$name SLAAC" "[[ -n \$(client_addr $name) ]]"
    global_addrs=$(dc "$name" ip -o -6 addr show dev eth0 scope global)
    [[ $(printf '%s\n' "$global_addrs" | wc -l) -eq 1 && $global_addrs != *temporary* ]] || die "$name has unexpected global IPv6 addresses: $global_addrs"
    addr=$(client_addr "$name")
    addresses[$name]=$addr
    assert_contains "$(dc "$name" ip -4 route get "$isp_identity4")" "via 192.168.$n.1"
    dc "$name" ping -4 -c 1 -W 2 "$isp_identity4" >/dev/null || die "$name cannot reach WAN over IPv4"
    wait_for "$name IPv6 WAN connectivity" "dc $name ping -6 -I $addr -c 1 -W 2 ${dmz6}"
    wait_for "$name ISP on-link connectivity" "dc $name ping -6 -I $addr -c 1 -W 2 ${isp_customer6}"
    wait_for "$name route installation" "dc router ip -6 route get $addr | grep -q 'dev eth$n'"
    dc isp ping -6 -c 1 -W 2 "$addr" >/dev/null || die "ISP cannot reach $name"
    assert_contains "$(dc router ip -6 neigh show proxy dev eth0)" "$addr"
    dc dmz ping -6 -c 1 -W 2 "$addr" >/dev/null || die "DMZ cannot reach $name"
    check_website "$name"
    note "$name IPv4/IPv6 WAN, DMZ, HTTP content and upstream NDP passed"
  done
  proxy_table=$(dc router ip -6 neigh show proxy)
  for name in client{1..8} client1b; do
    n=${lans[$name]}
    addr=${addresses[$name]}
    for peer in {0..8}; do
      if (( peer == n )); then
        [[ $proxy_table != *"$addr dev eth$peer proxy"* ]] || die "$name is proxied on its own LAN"
      else
        assert_contains "$proxy_table" "$addr dev eth$peer proxy"
      fi
    done
    assert_contains "$proxy_table" "${isp_customer6} dev eth$n proxy"
  done
  for name in client{1..8} client1b; do
    for peer in client{1..8} client1b; do
      [[ ${lans[$name]} == "${lans[$peer]}" ]] && continue
      dc "$name" ping -4 -c 1 -W 2 "${ipv4[$peer]}" >/dev/null || die "$name cannot reach $peer over IPv4"
      dc "$name" ping -6 -c 1 -W 2 "${addresses[$peer]}" >/dev/null || die "$name cannot reach $peer over IPv6"
    done
  done
  note 'all cross-LAN IPv4 and IPv6 pairs passed'
  addr1=${addresses[client1]}
  addr1b=${addresses[client1b]}
  dc client1b ping -6 -c 2 -W 2 "$addr1" >/dev/null || die 'LAN1 peers cannot communicate'
  dc router nft delete table inet ndp64labcheck >/dev/null 2>&1 || true
  dc router nft add table inet ndp64labcheck
  dc router nft add chain inet ndp64labcheck forward '{ type filter hook forward priority 10; policy accept; }'
  dc router nft add rule inet ndp64labcheck forward ip6 saddr "$addr1" ip6 daddr "$addr1b" counter
  dc router nft add rule inet ndp64labcheck forward ip6 saddr "$addr1b" ip6 daddr "$addr1" counter
  for name in client1 client1b; do
    if [[ $name == client1 ]]; then addr=$addr1b; peer_mac=02:42:ac:10:01:0b; else addr=$addr1; peer_mac=02:42:ac:10:01:0a; fi
    route=$(dc "$name" ip -6 route get "$addr")
    assert_contains "$route" 'dev eth0'
    [[ $route != *'via '* ]] || die "$name routes its LAN1 peer through a gateway"
    dc "$name" ping -6 -c 1 -W 2 "$addr" >/dev/null
    neigh=$(dc "$name" ip -6 neigh show "$addr" dev eth0)
    assert_contains "$neigh" "$peer_mac"
  done
  if dc router nft list chain inet ndp64labcheck forward | grep -Eq 'counter packets [1-9]'; then
    die 'LAN1 peer traffic entered the router forwarding path'
  fi
  assert_contains "$(dc router ip -6 route get "$addr1")" 'dev eth1'
  assert_contains "$(dc router ip -6 route get "${addresses[client2]}")" 'dev eth2'
  dc client1 ping -6 -I "$addr1" -c 2 -W 2 "$dmz6" >/dev/null || die 'explicit source address failed'
  dc router nft add rule inet ndp64labcheck forward iifname eth0 ip6 daddr "$addr1" tcp dport 12345 counter
  # Prove a service is listening before checking the firewall; a closed port
  # or unsupported nc option must not make this test pass.
  dc client1 sh -c 'mkdir -p /tmp/inbound; printf inbound > /tmp/inbound/index.html; httpd -p 12345 -h /tmp/inbound'
  [[ $(dc client1 curl --noproxy '*' --fail --silent --max-time 2 'http://[::1]:12345/') == inbound ]] || die 'inbound test listener is unavailable'
  for name in isp dmz; do
    if dc "$name" curl --noproxy '*' --fail --silent --max-time 2 "http://[$addr1]:12345/" >/dev/null 2>&1; then
      die "new inbound TCP from $name unexpectedly connected"
    fi
  done
  dc client1 sh -c 'kill $(pidof httpd)'
  if dc router nft list chain inet ndp64labcheck forward | grep -Eq 'tcp dport 12345 counter packets [1-9]'; then
    die 'new inbound TCP passed the WAN firewall'
  fi
  dc router nft delete table inet ndp64labcheck
  check_website dmz
  note 'all acceptance checks passed'
}

up_applet() { require_no_args "$@"; do_up; }
test_applet() { require_no_args "$@"; do_test; }
purge_applet() { require_no_args "$@"; do_purge; }
reset_applet() { require_no_args "$@"; do_purge; do_up; do_test; }
exec_applet() {
  (( $# > 0 )) || die 'usage: ./lab exec <container suffix> [command [arguments...]]'
  local suffix=$1
  shift
  if (( $# > 0 )); then
    dc "$suffix" "$@"
  else
    docker exec -it "$(container "$suffix")" /bin/sh
  fi
}

# Allow the address generator to be exercised without Docker.
if [[ ${BASH_SOURCE[0]} != "$0" ]]; then return 0; fi

(( $# > 0 )) || die 'usage: ./lab {up|test|purge|reset|exec}'
applet=$1; shift
case "$applet" in
  up) up_applet "$@" ;;
  test) test_applet "$@" ;;
  purge) purge_applet "$@" ;;
  reset) reset_applet "$@" ;;
  exec) exec_applet "$@" ;;
  *) die "unknown applet: $applet" ;;
esac
