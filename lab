#!/usr/bin/env bash
set -euo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
generated=$here/.generated
prefix=ndp64lab
label="org.ndp64lab.owner=$prefix"
builder=ndp64labbuilder
router25_image=ndp64labrouter:25.12.6
router21_image=ndp64labrouter:21.02.7
peer_image=ndp64labpeer:3.20
isp_image=ndp64labisp:3.20
debian_image=ndp64labclient:trixie
alpine_image=ndp64labclient:alpine
fw3_image=ndp64labclient:21.02.7
fw4_image=ndp64labclient:25.12.6
fw3_base=openwrt/rootfs:x86-64-21.02.7@sha256:7fc2353153c65d64a35a5fb4dc21a15bb048d812c19df3d8d4ea97745349ef79
fw4_base=openwrt/rootfs:x86-64-25.12.6@sha256:14401c04218c2e0da0448f099710ada2460636a92395f353351cc616cf3f67af

# Subscriber ID, release, customer address offset, ISP interface.
subscribers() {
  printf '%s\n' '25 25.12.6 100 1' '21 21.02.7 150 2'
}
select_subscriber() {
  branch=$1
  local id release offset port
  while read -r id release offset port; do
    [[ $id == "$branch" ]] || continue
    isp_port=eth$port
    isp_customer4=$customer4.$offset
    router4=$customer4.$((offset + 1))
    shared6=$customer6:$offset::
    isp_customer6=${shared6}1
    router6=${shared6}2
    router_image=ndp64labrouter:$release
    return
  done < <(subscribers)
  die "unknown subscriber: $branch"
}
# Container suffix, LAN, host octet, native manager.
clients() {
  local id release offset port
  while read -r id release offset port; do
    printf '%s\n' "client$id-networkd 1 10 networkd" "client$id-nm 1 11 networkmanager" \
      "client$id-alpine 2 10 alpine" "client$id-fw4 3 10 fw4" "client$id-fw3 3 11 fw3"
  done < <(subscribers)
}
branch_clients() { clients | awk -v id="$branch" '$1 ~ "^client" id "-"'; }
containers() {
  printf '%s\n' isp website dmz
  local id release offset port name lan host kind
  while read -r id release offset port; do printf '%s\n' "router$id" "roaming$id"; done < <(subscribers)
  while read -r name lan host kind; do printf '%s\n' "$name"; done < <(clients)
}
segments() {
  printf '%s\n' public dmz
  local id release offset port n
  while read -r id release offset port; do
    printf 'wan%s\n' "$id"
    for n in 1 2 3; do printf '%s-%s\n' "$id" "$n"; done
  done < <(subscribers)
}
client_manifest() {
  printf 'layout two-subscribers-v1\n'
  subscribers
  clients
  printf '%s\n' 'roaming25 1 dhcp networkd' 'roaming21 1 dhcp networkd'
}
prepare_clients() {
  local name lan host kind config
  while read -r name lan host kind; do
    mkdir -p "$generated/clients/$name"
    config=$generated/clients/$name/network
    case $kind in
      networkd)
        cat > "$config" <<EOF
[Match]
Name=eth0
[Network]
Address=192.168.$lan.$host/24
Gateway=192.168.$lan.1
DHCP=no
IPv6AcceptRA=yes
IPv6PrivacyExtensions=no
LinkLocalAddressing=ipv6
[IPv6AcceptRA]
Token=eui64
UseDNS=no
EOF
        ;;
      networkmanager)
        cat > "$config" <<EOF
[connection]
id=lab
type=ethernet
interface-name=eth0
autoconnect=true
[ipv4]
method=manual
address1=192.168.$lan.$host/24,192.168.$lan.1
[ipv6]
method=auto
addr-gen-mode=eui64
ip6-privacy=0
ignore-auto-dns=true
EOF
        ;;
      alpine)
        cat > "$config" <<EOF
auto lo
iface lo inet loopback
auto eth0
iface eth0 inet static
    address 192.168.$lan.$host/24
    gateway 192.168.$lan.1
    pre-up sysctl -w net.ipv6.conf.eth0.accept_ra=1 net.ipv6.conf.eth0.autoconf=1 net.ipv6.conf.eth0.addr_gen_mode=0
EOF
        ;;
      fw3|fw4)
        cat > "$config" <<EOF
config interface 'loopback'
    option device 'lo'
    option ifname 'lo'
    option proto 'static'
    option ipaddr '127.0.0.1'
    option netmask '255.0.0.0'
config interface 'lan'
    option device 'eth0'
    option ifname 'eth0'
    option proto 'static'
    option ipaddr '192.168.$lan.$host'
    option netmask '255.255.255.0'
    option gateway '192.168.$lan.1'
config interface 'lan6'
    option device '@lan'
    option ifname '@lan'
    option proto 'dhcpv6'
    option reqaddress 'none'
    option reqprefix 'no'
    option delegate '0'
    option peerdns '0'
EOF
        cat > "$generated/clients/$name/firewall" <<'EOF'
config defaults
    option input 'ACCEPT'
    option output 'ACCEPT'
    option forward 'REJECT'
config zone
    option name 'lan'
    list network 'lan'
    list network 'lan6'
    option input 'ACCEPT'
    option output 'ACCEPT'
    option forward 'REJECT'
EOF
        ;;
    esac
  done < <(clients)
  local id release offset port
  while read -r id release offset port; do
  mkdir -p "$generated/clients/roaming$id"
  cat > "$generated/clients/roaming$id/network" <<'EOF'
[Match]
Name=eth0
[Network]
DHCP=ipv4
IPv6AcceptRA=yes
IPv6PrivacyExtensions=no
LinkLocalAddressing=ipv6
[DHCPv4]
ClientIdentifier=mac
UseDNS=no
[IPv6AcceptRA]
Token=eui64
UseDNS=no
EOF
  done < <(subscribers)
  client_manifest > "$generated/client-manifest"
}

die() { printf 'lab: %s\n' "$*" >&2; exit 1; }
note() { printf 'lab: %s\n' "$*" >&2; }
require_no_args() { (( $# == 0 )) || die "$applet takes no arguments"; }
container() { printf '%s%s' "$prefix" "$1"; }
network() { printf '%s%s' "$prefix" "$1"; }
dc() { docker exec "$(container "$1")" "${@:2}"; }
require_tools() {
  [[ $(uname -sm) == 'Linux x86_64' ]] || die 'requires Linux x86_64'
  command -v docker >/dev/null || die 'missing docker'
  docker info >/dev/null || die 'Docker Engine is unavailable'
  local component version
  for component in Client Server; do
    version=$(docker version --format "{{.$component.Version}}")
    [[ $version =~ ^([0-9]+)\. ]] && (( BASH_REMATCH[1] >= 28 )) || die "Docker $component 28 or newer is required for interface naming"
  done
  docker buildx version >/dev/null || die 'Docker buildx is unavailable'
}
# Only this table in the Topology section supplies address naming seeds.
load_addresses() {
  local key seed stem4 stem6
  local -A seeds=()
  while IFS=' ' read -r key seed; do
    [[ $key == customer || $key == public ]] || die "unknown address key: $key"
    [[ ! -v seeds[$key] ]] || die "duplicate address key: $key"
    [[ $seed =~ ^[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ]{3}$ ]] || die "address seed $key must contain three ASCII letters"
    seeds[$key]=$seed
  done < <(LC_ALL=C awk '
    /^## Topology$/ {topology=1; next}
    topology && /^## / {exit}
    topology && /^\| `address-seed:/ {
      gsub(/`/, "", $2); gsub(/address-seed:/, "", $2)
      gsub(/`/, "", $3); print $2, $3
    }' FS='|' "$here/README.md")
  for key in customer public; do
    [[ -v seeds[$key] ]] || die "missing address-seed:$key in README Topology table"
    seed=${seeds[$key]}
    LC_ALL=C printf -v stem4 '%d.%d.%d' "'${seed:0:1}" "'${seed:1:1}" "'${seed:2:1}"
    LC_ALL=C printf -v stem6 '2%03d:%d:%d' "'${seed:0:1}" "'${seed:1:1}" "'${seed:2:1}"
    if [[ $key == customer ]]; then customer4=$stem4; customer6=$stem6
    else public4=$stem4; public6=$stem6; fi
  done
  [[ $customer4 != "$public4" ]] || die 'customer and public seeds must differ'
  isp_identity4=$customer4.1
  isp_dmz4=$customer4.200
  dmz4=$customer4.201
  isp_public4=$public4.1
  website4=$public4.2
  isp_dmz6=$customer6:200::1
  dmz6=$customer6:200::2
  isp_public6=$public6::1
  website6=$public6::2
  select_subscriber 25
}
# Match Docker's historical IPv4-based MAC formula, using intended lab addresses.
mac_from_ipv4() {
  local address=$1 octet
  local -a octets=()
  [[ $address =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "invalid IPv4 address: $address"
  IFS=. read -r -a octets <<< "$address"
  for octet in "${octets[@]}"; do
    [[ ${#octet} -le 3 ]] && (( 10#$octet <= 255 )) || die "invalid IPv4 address: $address"
  done
  printf '02:42:%02x:%02x:%02x:%02x' "$((10#${octets[0]}))" "$((10#${octets[1]}))" \
    "$((10#${octets[2]}))" "$((10#${octets[3]}))"
}
# One row per Ethernet endpoint: container suffix, interface, intended IPv4.
interface_addresses() {
  printf '%s\n' "isp eth0 $isp_public4" "isp eth3 $isp_dmz4" "website eth0 $website4" "dmz eth0 $dmz4"
  local id release offset port n name lan host kind
  while read -r id release offset port; do
    printf '%s\n' "isp eth$port $customer4.$offset" "router$id eth0 $customer4.$((offset + 1))"
    for n in 1 2 3; do printf '%s\n' "router$id eth$n 192.168.$n.1"; done
    printf '%s\n' "roaming$id eth0 192.168.0.12"
  done < <(subscribers)
  while read -r name lan host kind; do printf '%s\n' "$name eth0 192.168.$lan.$host"; done < <(clients)
}
endpoint_segment() {
  local name=$1 interface=$2
  case $name in
    isp) case $interface in eth0) echo public;; eth1) echo wan25;; eth2) echo wan21;; eth3) echo dmz;; esac ;;
    website) echo public;; dmz) echo dmz;;
    router*) if [[ $interface == eth0 ]]; then echo wan${name#router}; else echo "${name#router}-${interface#eth}"; fi ;;
    roaming*) echo "${name#roaming}-1" ;;
    client*) local n l h k; while read -r n l h k; do [[ $n != "$name" ]] || echo "${name:6:2}-$l"; done < <(clients) ;;
  esac
}

endpoint_network() {
  printf 'name=%s,mac-address=%s,driver-opt=com.docker.network.endpoint.ifname=%s' \
    "$(network "$1")" "$(mac_from_ipv4 "$3")" "$2"
}
check_interface_macs() {
  local name interface address expected actual segment key
  local -A seen=()
  while read -r name interface address; do
    expected=$(mac_from_ipv4 "$address")
    segment=$(endpoint_segment "$name" "$interface"); key=$segment/$expected
    [[ -n $segment && ! -v seen[$key] ]] || die "duplicate or unassigned MAC on $segment: $expected"
    seen[$key]=1
    actual=$(dc "$name" cat "/sys/class/net/$interface/address" 2>/dev/null) || actual=missing
    [[ $actual == "$expected" ]] || die "$name $interface MAC is $actual; expected $expected from $address; run ./lab reset"
  done < <(interface_addresses)
  note 'all interface MACs match their address seeds'
}
address_manifest() {
  printf 'layout=two-subscribers-v1\ncustomer4=%s\ncustomer6=%s\nwebsite4=%s\nwebsite6=%s\n' "$customer4" "$customer6" "$website4" "$website6"
}
prepare_configuration() {
  mkdir -p "$generated/www"
  head -c 3072 /dev/urandom | base64 | tr -d '\n' > "$generated/www/index.html"
  [[ $(wc -c < "$generated/www/index.html") == 4096 ]] || die 'payload generation failed'
  printf '.html:text/plain\n' > "$generated/www/httpd.conf"
  address_manifest > "$generated/addresses"
  prepare_clients
  local id release offset port
  while read -r id release offset port; do
    select_subscriber "$id"
    mkdir -p "$generated/router$id"
    sed -e "s/@ROUTER4@/$router4/g" -e "s/@GATEWAY4@/$isp_customer4/g" \
      -e "s/@ROUTER6@/$router6/g" -e "s/@SHARED6@/$shared6/g" -e "s/@ISP6@/$isp_customer6/g" "$here/router/network" > "$generated/router$id/network"
    cp "$here/router/dhcp" "$generated/router$id/dhcp"
    if [[ $id == 21 ]]; then
      # odhcpd 21 caps RA lifetimes using DHCP lease/preferred lifetimes.
      sed -i -e "s/max_preferred_lifetime/preferred_lifetime/" \
        -e "s/option max_valid_lifetime '300s'/option ra_useleasetime '1'/" "$generated/router$id/dhcp"
    fi
  done < <(subscribers)
}
owned_container() {
  [[ $(docker inspect -f '{{index .Config.Labels "org.ndp64lab.owner"}}' "$1" 2>/dev/null) == "$prefix" ]]
}
owned_network() {
  [[ $(docker network inspect -f '{{index .Labels "org.ndp64lab.owner"}}' "$1" 2>/dev/null) == "$prefix" ]]
}
check_name_free() {
  local name=$1
  if docker container inspect "$name" >/dev/null 2>&1; then
    owned_container "$name" || die "container name $name belongs to another owner"
    die "lab already exists; run ./lab reset"
  fi
}
check_image_owned_or_free() {
  local owner
  owner=$(docker image inspect -f '{{index .Config.Labels "org.ndp64lab.owner"}}' "$1" 2>/dev/null) || return 0
  [[ $owner == "$prefix" ]] || die "image tag $1 belongs to another owner"
}
wait_for() {
  local description=$1 command=$2 deadline=$((SECONDS + ${3:-60}))
  until eval "$command" >/dev/null 2>&1; do
    (( SECONDS < deadline )) || die "timed out waiting for $description"
    sleep 1
  done
}
prepare_build_repositories() {
  local image=$1 destination=$2 architecture=x86_64
  mkdir -p "$destination"
  # Read the base image's real feed files without giving it network access.
  docker run --rm --network none --read-only --entrypoint /bin/sh "$image" -c '
    cd /
    set --
    for file in etc/opkg/distfeeds.conf etc/apk/repositories etc/apk/repositories.d/*.list \
                etc/apt/sources.list etc/apt/sources.list.d/*.list etc/apt/sources.list.d/*.sources; do
      [ ! -f "$file" ] || set -- "$@" "$file"
    done
    [ "$#" -gt 0 ] || exit 1
    tar -cf - "$@"
  ' | tar -xf - -C "$destination"
  if [[ -f $destination/etc/apk/repositories ]]; then
    architecture=$(docker run --rm --network none --read-only --entrypoint /sbin/apk "$image" --print-arch)
  fi
  sh "$here/build/configure-mirror.sh" "${BUILD_MIRROR:-}" "$destination" "$architecture"
}
build_image() {
  local dockerfile=$1 image=$2 base=$3
  shift 3
  local repositories
  repositories=$(mktemp -d "$generated/repositories.XXXXXX")
  prepare_build_repositories "$base" "$repositories"
  docker buildx build --builder "$builder" --load --build-arg "LAB_ID=$prefix" \
    --build-context "repositories=$repositories" "$@" -f "$here/$dockerfile" -t "$image" "$here"
  rm -rf -- "$repositories"
}
build_images() {
  if [[ -n ${BUILD_MIRROR:-} ]]; then command -v curl >/dev/null || die 'BUILD_MIRROR requires curl on the host'; fi
  mkdir -p "$generated"
  if [[ ! -e "$generated/builder-owned" ]]; then
    docker buildx inspect "$builder" >/dev/null 2>&1 && die "builder $builder exists without ownership marker"
    touch "$generated/builder-owned"
    docker buildx create --name "$builder" --driver docker-container >/dev/null
  fi
  local alpine_base id release offset port base
  alpine_base=$(awk '$1 == "FROM" {base=$2} END {print base}' "$here/Dockerfile.client-alpine")
  build_image Dockerfile.isp "$isp_image" "$alpine_base"
  build_image Dockerfile.peer "$peer_image" "$alpine_base"
  build_image Dockerfile.client-debian "$debian_image" debian:trixie-slim
  build_image Dockerfile.client-alpine "$alpine_image" "$alpine_base"
  while read -r id release offset port; do
    if [[ $id == 25 ]]; then base=$fw4_base; else base=$fw3_base; fi
    build_image Dockerfile.router "ndp64labrouter:$release" "$base" --build-arg "OPENWRT_IMAGE=$base" --target router
    build_image Dockerfile.router "ndp64labclient:$release" "$base" --build-arg "OPENWRT_IMAGE=$base" --target client
  done < <(subscribers)
}

create_networks() {
  local segment
  while read -r segment; do
    local name; name=$(network "$segment")
    docker network inspect "$name" >/dev/null 2>&1 && die "network $name already exists"
    docker network create --internal --driver bridge --label "$label" "$name" >/dev/null
  done < <(segments)
}
prepare_firewall3() {
  local module missing=0
  local -a modules=(ip_tables ip6_tables iptable_filter ip6table_filter iptable_nat ip6table_nat iptable_mangle ip6table_mangle iptable_raw ip6table_raw xt_TCPMSS xt_MASQUERADE xt_conntrack xt_tcpudp xt_comment xt_multiport xt_limit xt_LOG ipt_REJECT ip6t_REJECT)
  for module in "${modules[@]}"; do [[ -d /sys/module/$module ]] || missing=1; done
  if (( missing )); then
    [[ -d /lib/modules/$(uname -r) ]] || die 'firewall3 requires host xtables modules'
    printf '%s\n' "${modules[@]}" > "$generated/firewall3-modules.conf"
    docker run --rm --privileged --network none --label "$label" \
      --volume /lib/modules:/lib/modules:ro \
      --volume "$generated/firewall3-modules.conf:/etc/modules-load.d/lab.conf:ro" \
      "$debian_image" /lib/systemd/systemd-modules-load
  fi
}

# Each native configuration is installed before PID 1 starts.
copy_config() { tar --owner=0 --group=0 --transform="s|.*|${3#/}|" -cf - -C "$(dirname "$2")" "$(basename "$2")" | docker cp - "$(container "$1"):/"; }
prepare_peer_configs() {
  local name port ports address gateway id release offset
  for name in isp dmz website; do
    mkdir -p "$generated/peers/$name"
    {
      printf 'auto lo\niface lo inet loopback\n'
      if [[ $name == isp ]]; then
        printf '    up ip addr add %s/32 dev lo\n' "$isp_identity4"
        printf 'auto eth0\niface eth0 inet static\n    address %s/30\niface eth0 inet6 static\n    address %s/64\n' "$isp_public4" "$isp_public6"
        while read -r id release offset port; do
          printf 'auto eth%s\niface eth%s inet static\n    address %s.%s/31\niface eth%s inet6 static\n    address %s:%s::1/128\n' \
            "$port" "$port" "$customer4" "$offset" "$port" "$customer6" "$offset"
        done < <(subscribers)
        printf 'auto eth3\niface eth3 inet static\n    address %s/31\niface eth3 inet6 static\n    address %s/128\n' "$isp_dmz4" "$isp_dmz6"
      else
        if [[ $name == dmz ]]; then address=$dmz4/31; gateway=$isp_dmz4
        else address=$website4/30; gateway=$isp_public4; fi
        printf 'auto eth0\niface eth0 inet static\n    address %s\n    gateway %s\n' "$address" "$gateway"
        if [[ $name == dmz ]]; then address=$dmz6/64; gateway=$isp_dmz6
        else address=$website6/64; gateway=$isp_public6; fi
        printf 'iface eth0 inet6 static\n    address %s\n    gateway %s\n' "$address" "$gateway"
      fi
    } > "$generated/peers/$name/interfaces"
    sed -i '/^iface eth[0-9] inet static/a\\    pre-up ip -4 addr flush dev $IFACE' "$generated/peers/$name/interfaces"
    # Interface sysctls belong to native ifupdown configuration, after Docker
    # has created the named interfaces.
    if [[ $name == isp ]]; then ports='eth0 eth1 eth2 eth3'; else ports=eth0; fi
    for port in $ports; do
      sed -i "/^iface $port inet static/a\\    pre-up sysctl -w net.ipv6.conf.$port.disable_ipv6=0" "$generated/peers/$name/interfaces"
      if [[ $name != website ]]; then
        sed -i "/^iface $port inet static/a\\    pre-up sysctl -w net.ipv6.neigh.$port.base_reachable_time_ms=5000 net.ipv6.neigh.$port.gc_stale_time=5 net.ipv6.neigh.$port.delay_first_probe_time=1 net.ipv6.neigh.$port.retrans_time_ms=1000" "$generated/peers/$name/interfaces"
      fi
    done
    if [[ $name == dmz ]]; then
      # Unicast NUD probes have no queued packet source. Without a link-local
      # address Linux selects this static global address for gateway NS too.
      sed -i '/^iface eth0 inet static/a\\    pre-up sysctl -w net.ipv6.conf.eth0.addr_gen_mode=1\n    pre-up ip -6 addr flush dev eth0 scope link' "$generated/peers/$name/interfaces"
    fi
  done
  {
    printf '[supervisord]\nnodaemon=true\nuser=root\n'
    while read -r id release offset port; do
      cat <<EOF
[program:subscriber$id]
command=/usr/sbin/isp-ndp-learn $customer6:$offset::/64 $customer6:$offset::1 eth$port 15
autorestart=true
stdout_logfile=/tmp/isp-learning-eth$port.log
stderr_logfile=/tmp/isp-learning-eth$port.log
EOF
    done < <(subscribers)
    cat <<EOF
[program:dmz]
command=/usr/sbin/isp-ndp-learn $customer6:200::/64 $isp_dmz6 eth3 15
autorestart=true
stdout_logfile=/tmp/isp-learning-eth3.log
stderr_logfile=/tmp/isp-learning-eth3.log
EOF
  } > "$generated/peers/isp/supervisord.conf"
}

start_peers() {
  prepare_peer_configs
  local name image id release offset port
  local -a options networks
  networks=(--network "$(endpoint_network public eth0 "$isp_public4")" --network "$(endpoint_network dmz eth3 "$isp_dmz4")")
  while read -r id release offset port; do networks+=(--network "$(endpoint_network wan$id eth$port "$customer4.$offset")"); done < <(subscribers)
  docker create --privileged --name "$(container isp)" --label "$label" \
    --sysctl net.ipv4.ip_forward=1 --sysctl net.ipv6.conf.all.forwarding=1 \
    "${networks[@]}" "$isp_image" >/dev/null
  copy_config isp "$generated/peers/isp/supervisord.conf" /etc/supervisord.conf
  for name in dmz website; do
    options=()
    if [[ $name == dmz ]]; then
      options+=(--network "$(endpoint_network dmz eth0 "$dmz4")")
    else
      options+=(--volume "$generated/www:/www:ro" --network "$(endpoint_network public eth0 "$website4")")
    fi
    docker create --privileged --name "$(container "$name")" --label "$label" "${options[@]}" "$peer_image" >/dev/null
  done
  for name in isp dmz website; do
    copy_config "$name" "$generated/peers/$name/interfaces" /etc/network/interfaces
  done
  docker start "$(container isp)" >/dev/null
  wait_for 'ISP NS learners' '[[ $(dc isp pidof isp-ndp-learn | wc -w) -eq 3 ]]'
  configure_router_gateway
  docker start "$(container dmz)" "$(container website)" >/dev/null
}

start_clients() {
  local name lan host kind image path
  local -a options
  while read -r name lan host kind; do
    options=()
    case $kind in
      networkd|networkmanager)
        image=$debian_image
        options+=(--cgroupns private --tmpfs /run --tmpfs /run/lock --tmpfs /tmp --env container=docker)
        if [[ $kind == networkd ]]; then path=/etc/systemd/network/20-lab.network
        else path=/etc/NetworkManager/system-connections/lab.nmconnection; chmod 600 "$generated/clients/$name/network"; fi
        ;;
      alpine) image=$alpine_image; path=/etc/network/interfaces ;;
      fw3) image=$fw3_image; path=/etc/config/network ;;
      fw4) image=$fw4_image; path=/etc/config/network ;;
    esac
    docker create --privileged --name "$(container "$name")" --label "$label" \
      --env "LAB_CLIENT_KIND=$kind" "${options[@]}" \
      --network "$(endpoint_network "${name:6:2}-$lan" eth0 "192.168.$lan.$host")" "$image" >/dev/null
    copy_config "$name" "$generated/clients/$name/network" "$path"
    case $kind in fw3|fw4) copy_config "$name" "$generated/clients/$name/firewall" /etc/config/firewall ;; esac
    docker start "$(container "$name")" >/dev/null
  done < <(clients)
  local id release offset port
