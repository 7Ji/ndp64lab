      wait_for "$name to $peer" "dc $name ping -6 -c 1 -W 2 ${addresses[$peer]}" 10
    done < <(branch_clients)
  done < <(branch_clients)
  check_lifetimes
  check_packets
  check_direct_peers
  check_failed_probe
  check_inbound
  check_registration_expiry
  check_roaming
  note "subscriber $branch acceptance checks passed"
}
do_test() {
  load_addresses
  require_tools
  [[ -f $generated/addresses && $(cat "$generated/addresses") == "$(address_manifest)" ]] || die 'stale deployment or changed address seeds; run ./lab reset'
  [[ -f $generated/client-manifest && $(cat "$generated/client-manifest") == "$(client_manifest)" ]] || die 'topology changed; run ./lab reset'
  local name device id release offset port
  while read -r name; do owned_container "$(container "$name")" || die "missing $name; run ./lab reset"; done < <(containers)
  check_client_managers || die 'native client manager/firewall unavailable'
  check_interface_macs
  while read -r name device _; do
    [[ $(dc "$name" ip -o -4 addr show dev "$device" | wc -l) -eq 1 ]] || die "$name $device retained bootstrap addresses"
  done < <(interface_addresses)
  wait_for 'DMZ registration' "dc dmz ping -6 -c 1 -W 2 $website6"
  assert_contains "$(dc isp ip -6 route show exact "$dmz6/128")" "$dmz6 dev eth3"
  check_isp_ns_learning
  while read -r id release offset port; do select_subscriber "$id"; check_subscriber; done < <(subscribers)
  check_website dmz
  note 'all acceptance checks passed'
}

up_applet() { require_no_args "$@"; do_up; }
test_applet() { require_no_args "$@"; do_test; }
purge_applet() { require_no_args "$@"; do_purge; }
reset_applet() { require_no_args "$@"; local preserve_build_cache=1; do_purge; do_up; do_test; }
exec_applet() {
  (( $# > 0 )) || die 'usage: ./lab exec <container suffix> [command [arguments...]]'
  local suffix=$1
  shift
  if (( $# > 0 )); then
    dc "$suffix" "$@"
  else
    docker exec -it "$(container "$suffix")" /bin/sh
  fi
}

# Allow the address generator to be exercised without Docker.
if [[ ${BASH_SOURCE[0]} != "$0" ]]; then return 0; fi

(( $# > 0 )) || die 'usage: ./lab {up|test|purge|reset|exec}'
applet=$1; shift
case "$applet" in
  up) up_applet "$@" ;;
  test) test_applet "$@" ;;
  purge) purge_applet "$@" ;;
  reset) reset_applet "$@" ;;
  exec) exec_applet "$@" ;;
  *) die "unknown applet: $applet" ;;
esac
