do_purge() {
  require_tools
  local resource
  while IFS= read -r resource; do [[ -z $resource ]] || docker rm -f "$resource" >/dev/null; done < <(docker ps -aq --filter "label=$label")
  while IFS= read -r resource; do [[ -z $resource ]] || docker network rm "$resource" >/dev/null; done < <(docker network ls -q --filter "label=$label")
  while IFS= read -r resource; do [[ -z $resource ]] || docker image rm -f "$resource" >/dev/null; done < <(docker image ls -q --filter "label=$label" | sort -u)
  local keep_builder=0
  if [[ -e $generated/builder-owned && ${preserve_build_cache:-0} == 1 ]]; then keep_builder=1; fi
  if [[ -e "$generated/builder-owned" && $keep_builder == 0 ]]; then
    docker buildx prune --builder "$builder" --all --force >/dev/null 2>&1 || true
    docker buildx rm "$builder" >/dev/null 2>&1 || true
  fi
  [[ ! -e "$generated" ]] || rm -rf -- "$generated"
  if (( keep_builder )); then mkdir -p "$generated"; touch "$generated/builder-owned"; fi
  note 'lab resources removed'
}
client_addr() {
  dc "$1" ip -o -6 addr show dev eth0 scope global | awk -v prefix="$shared6" 'index($4, substr(prefix, 1, length(prefix)-1)) == 1 && !/tentative|dadfailed/ {split($4,a,"/"); print a[1]; exit}'
}
proxy_entries() {
  # ip-full 5.x prints an extra space before proxy; compare fields consistently.
  dc "$1" ip -6 neigh show proxy "${@:2}" | awk '{$1=$1; print}'
}
assert_contains() { [[ $1 == *"$2"* ]] || die "expected '$2' in: $1"; }
check_website() {
  local name=$1 target response
  [[ $(wc -c < "$generated/www/index.html") == 4096 ]] || die 'invalid deployment payload size'
  LC_ALL=C tr -d ' -~' < "$generated/www/index.html" | cmp -s - /dev/null || die 'non-printable deployment payload'
  response=$(mktemp "$generated/http.XXXXXX")
  for target in "$website4" "[$website6]"; do
    # Curl fails on HTTP errors; cmp compares every byte, including trailing newlines.
    if ! dc "$name" curl --noproxy '*' --fail --silent --show-error --max-time 5 "http://$target/" > "$response"; then
      rm -f "$response"
      die "$name HTTP request to $target failed"
    fi
    if ! cmp -s "$response" "$generated/www/index.html"; then
      rm -f "$response"
      die "$name HTTP body from $target differs from deployment payload"
    fi
  done
  rm -f "$response"
}
check_isp_ns_learning() (
  cleanup_isp_probe() {
    dc dmz ip -6 addr del "$customer6:200::1234/128" dev eth0 >/dev/null 2>&1 || true
    dc dmz ip -6 neigh del "$isp_dmz6" dev eth0 >/dev/null 2>&1 || true
  }
  trap cleanup_isp_probe EXIT
  local probe=$customer6:200::1234
  # Clear a previous interrupted check, then force data traffic without NS.
  dc dmz ip -6 addr del "$probe/128" dev eth0 >/dev/null 2>&1 || true
  dc isp ip -6 route del "$probe/128" dev eth3 >/dev/null 2>&1 || true
  dc isp ip -6 neigh del "$probe" dev eth3 >/dev/null 2>&1 || true
  dc dmz ip -6 addr add "$probe/128" dev eth0 nodad
  dc dmz ip -6 neigh replace "$isp_dmz6" lladdr "$(mac_from_ipv4 "$isp_dmz4")" nud permanent dev eth0
  if dc dmz ping -6 -I "$probe" -c 1 -W 1 "$website6" >/dev/null 2>&1; then
    die 'ISP returned traffic to a source that never sent NS'
  fi
  [[ -z $(dc isp ip -6 route show exact "$probe/128") ]] || die 'ISP learned a route from ordinary traffic'
  [[ -z $(dc isp ip -6 neigh show "$probe" dev eth3) ]] || die 'ISP learned a neighbor from ordinary traffic'
  # Force a real gateway NS using the probe as its source, then check both tables.
  dc dmz ip -6 neigh del "$isp_dmz6" dev eth0
  wait_for 'DMZ probe NS registration' "dc dmz ping -6 -I $probe -c 1 -W 2 $website6"
  assert_contains "$(dc isp ip -6 route show exact "$probe/128")" "$probe dev eth3"
  assert_contains "$(dc isp ip -6 neigh show "$probe" dev eth3)" "$(mac_from_ipv4 "$dmz4")"
  # Keep data flowing and force NUD to solicit fresh NAs. Neither extends
  # the registration deadline. The permanent gateway prevents fresh client NS.
  dc dmz ip -6 neigh replace "$isp_dmz6" lladdr "$(mac_from_ipv4 "$isp_dmz4")" nud permanent dev eth0
  dc isp ip -6 neigh change "$probe" dev eth3 nud probe
  local expiry=$((SECONDS + 18))
  while (( SECONDS < expiry )); do
    dc dmz ping -6 -I "$probe" -c 1 -W 1 "$website6" >/dev/null 2>&1 || true
    dc isp ping -6 -c 1 -W 1 "$probe" >/dev/null 2>&1 || true
    sleep 1
  done
  [[ -z $(dc isp ip -6 route show exact "$probe/128") ]] || die 'ordinary traffic or NA postponed registration expiry'
  [[ -z $(dc isp ip -6 neigh show "$probe" dev eth3) ]] || die 'expired probe retained its ISP neighbor'
  dc dmz ip -6 addr del "$probe/128" dev eth0
  dc dmz ip -6 neigh del "$isp_dmz6" dev eth0
  note 'ISP ignores ordinary sources and learns route/neighbor from NS'
)
check_client_managers() {
  local name lan host kind
  while read -r name lan host kind; do
    [[ $(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$(container "$name")") == *"LAB_CLIENT_KIND=$kind"* ]] || die "$name has wrong client kind; run ./lab reset"
    case $kind in
      networkd) dc "$name" systemctl is-active --quiet systemd-networkd || return 1 ;;
      networkmanager)
        dc "$name" systemctl is-active --quiet NetworkManager || return 1
        [[ $(dc "$name" nmcli -g GENERAL.CONNECTION device show eth0) == lab ]] || return 1
        ;;
      alpine) dc "$name" ifquery --state eth0 >/dev/null || return 1 ;;
      fw3)
        dc "$name" pidof netifd >/dev/null || return 1
        dc "$name" iptables -S zone_lan_input >/dev/null || return 1
        dc "$name" ip6tables -S zone_lan_input >/dev/null || return 1
        dc "$name" fw3 print >/dev/null 2>&1 || return 1
        ;;
      fw4)
        dc "$name" pidof netifd >/dev/null || return 1
        dc "$name" nft list table inet fw4 >/dev/null || return 1
        ;;
    esac
    [[ $(dc "$name" ip -o -4 addr show dev eth0) == *"inet 192.168.$lan.$host/24"* ]] || return 1
    note "$name uses $kind"
  done < <(clients)
}
check_lifetimes() {
  local name output preferred valid
  while read -r name _; do
    output=$(dc "$name" ip -6 addr show dev eth0 scope global)
    [[ -n $output && $output != *forever* ]] || die "$name has invalid SLAAC lifetimes: $output"
    read -r valid preferred < <(awk '/valid_lft/ {gsub(/sec/, ""); print $2,$4; exit}' <<< "$output")
    [[ $preferred =~ ^[0-9]+$ && $valid =~ ^[0-9]+$ ]] || die "cannot read $name lifetimes"
    (( preferred <= 60 && valid <= 300 && valid > 0 )) || die "$name lifetimes exceed 60/300: $output"
  done < <(branch_clients; printf 'roaming%s\n' "$branch")
}
# Move the existing host veth rather than replacing eth0 or its MAC. Docker's
# endpoint remains assigned to LAN1; the test restores that bridge on exit.
move_roaming() {
  local lan=$1 bridge network_id peer_index
  [[ $lan =~ ^[1-3]$ ]] || die "invalid roaming LAN: $lan"
  owned_network "$(network "$branch-$lan")" || die 'roaming target network is not lab-owned'
  network_id=$(docker network inspect -f '{{.Id}}' "$(network "$branch-$lan")")
  bridge=$(docker network inspect -f '{{index .Options "com.docker.network.bridge.name"}}' "$(network "$branch-$lan")")
  [[ -n $bridge ]] || bridge=br-${network_id:0:12}
  [[ $(dc roaming$branch cat /sys/class/net/eth0/address) == "$(mac_from_ipv4 192.168.0.12)" ]] || die 'roaming MAC changed'
  peer_index=$(dc roaming$branch cat /sys/class/net/eth0/iflink)
  docker run --rm -i --privileged --network host --label "$label" "$peer_image" \
    sh -s -- "$peer_index" "$bridge" < "$here/tests/move-roaming.sh"
}
roaming_step_ready() {
  local lan=$1 address=$2 previous=$3 port=$4
  [[ $(client_addr roaming$branch) == "$address" ]] || return 1
  dc roaming$branch ip -o -4 addr show dev eth0 | awk -v net="192.168.$lan." '
    $3 == "inet" && index($4, net) == 1 {split($4,a,"/"); split(a[1],o,"."); if (o[4]>=100 && o[4]<=199) good=1}
    END {exit !good}' || return 1
  [[ $(dc roaming$branch ip -4 route show default) == *"via 192.168.$lan.1 dev eth0"* ]] || return 1
  [[ $(dc router$branch ip -6 route get "$address") == *"dev eth$lan "* ]] || return 1
  dc roaming$branch python3 -c '
import json,sys
s=json.load(open("/tmp/roaming-state.json"))
assert s["status"]=="running" and s["sequence"]>int(sys.argv[1])
assert s["source"]==sys.argv[2] and s["local_port"]==int(sys.argv[3])
' "$previous" "$address" "$port"
}
check_roaming() (
  restore_roaming() {
    dc roaming$branch touch /tmp/roaming-stop >/dev/null 2>&1 || true
    for endpoint in roaming$branch isp; do
      dc "$endpoint" sh -c 'test ! -f /tmp/roaming-traffic.pid || kill $(cat /tmp/roaming-traffic.pid)' >/dev/null 2>&1 || true
    done
    move_roaming 1 >/dev/null 2>&1 || true
  }
  trap restore_roaming EXIT
  local name n loop address interface_index port previous state
  move_roaming 1
  wait_for 'roaming initial SLAAC' '[[ -n $(client_addr roaming$branch) ]]'
  address=$(client_addr roaming$branch)
  interface_index=$(dc roaming$branch cat /sys/class/net/eth0/ifindex)
  dc roaming$branch systemctl is-active --quiet systemd-networkd
  for n in 1 2 3; do
    [[ $(dc router$branch uci -q get "dhcp.lan$n.dhcpv4") == server ]] || die "DHCPv4 is disabled on LAN$n"
  done
  for name in isp roaming$branch; do
    docker exec -i "$(container "$name")" sh -c 'cat > /tmp/roaming-traffic.py' < "$here/tests/roaming-traffic.py"
    dc "$name" sh -c 'rm -f /tmp/roaming-state.json /tmp/roaming-stop'
  done
  dc isp sh -c 'python3 -u /tmp/roaming-traffic.py server "$1" >/tmp/roaming-traffic.log 2>&1 & echo $! >/tmp/roaming-traffic.pid' sh "$isp_customer6"
  wait_for 'roaming TCP listener' "dc isp test -f /tmp/roaming-state.json"
  # Establish once. Neither the traffic program nor the move loop reconnects.
  wait_for 'roaming initial WAN registration' "dc roaming$branch ping -6 -c 1 -W 2 $isp_customer6"
  dc roaming$branch sh -c 'python3 -u /tmp/roaming-traffic.py client "$1" --source "$2" >/tmp/roaming-traffic.log 2>&1 & echo $! >/tmp/roaming-traffic.pid' sh "$isp_customer6" "$address"
  wait_for 'persistent roaming TCP connection' 'dc roaming$branch test -f /tmp/roaming-state.json'
  port=$(dc roaming$branch python3 -c 'import json; print(json.load(open("/tmp/roaming-state.json"))["local_port"])')
  for loop in 1; do
    for n in 2 3 1; do
      previous=$(dc roaming$branch python3 -c 'import json; print(json.load(open("/tmp/roaming-state.json"))["sequence"])')
      move_roaming "$n"
      wait_for "roaming loop $loop LAN$n DHCPv4 and existing TCP progress" "roaming_step_ready $n $address $previous $port"
      [[ $(dc roaming$branch cat /sys/class/net/eth0/ifindex) == "$interface_index" ]] || die 'roaming replaced the Ethernet interface'
      [[ $(dc roaming$branch cat /sys/class/net/eth0/address) == "$(mac_from_ipv4 192.168.0.12)" ]] || die 'roaming changed its MAC'
      [[ $(proxy_entries router$branch dev "eth$n") != *"$address proxy"* ]] || die 'roaming is proxied on its current LAN'
      assert_contains "$(dc isp ip -6 route show exact "$address/128")" "$address dev $isp_port"
      assert_contains "$(dc router$branch cat /tmp/dhcp.leases)" "$(mac_from_ipv4 192.168.0.12) 192.168.$n."
      check_website roaming$branch
      # Check direct connectivity with the existing static client on this LAN.
      dc roaming$branch ping -6 -c 1 -W 2 "$(client_addr "$(branch_clients | awk -v lan="$n" '$2==lan {print $1; exit}')")" >/dev/null || die "roaming cannot reach its LAN$n peer"
      note "roaming loop $loop LAN$n: DHCPv4, unchanged MAC/IPv6, existing TCP stream, HTTP and local peer passed"
    done
  done
  dc roaming$branch touch /tmp/roaming-stop
  wait_for 'roaming traffic completion' "dc roaming$branch python3 -c 'import json; assert json.load(open(\"/tmp/roaming-state.json\"))[\"status\"]==\"finished\"'"
  dc isp python3 -c 'import json; s=json.load(open("/tmp/roaming-state.json")); assert s["accepted"]==1 and s["source"]=="'"$address"'"'
  state=$(dc roaming$branch cat /tmp/roaming-state.json)
  note "subscriber $branch LAN1 → LAN2 → LAN3 → LAN1 retained one IPv6 TCP connection: $state"
  check_client_managers || die 'a static client changed while roaming'
)
check_failed_probe() (
