@@ -40,6 +40,38 @@
 		struct interface *iface, void *dest);
 
 static struct netevent_handler ndp_netevent_handler = { .cb = ndp_netevent_cb, };
+
+/* Only confirmed neighbors own relay state. A failed probe on another LAN
+ * never installed that state, so its expiry must not remove valid proxies. */
+struct relay_neighbor {
+ struct list_head head;
+ struct in6_addr addr;
+ int ifindex;
+};
+static LIST_HEAD(relay_neighbors);
+
+static bool relay_neighbor_update(const struct in6_addr *addr, int ifindex, bool add)
+{
+ struct relay_neighbor *n;
+ list_for_each_entry(n, &relay_neighbors, head) {
+  if (n->ifindex != ifindex || memcmp(&n->addr, addr, sizeof(*addr)))
+   continue;
+  if (!add) {
+   list_del(&n->head);
+   free(n);
+  }
+  return true;
+ }
+ if (!add)
+  return false;
+ n = calloc(1, sizeof(*n));
+ if (!n)
+  return false;
+ n->addr = *addr;
+ n->ifindex = ifindex;
+ list_add(&n->head, &relay_neighbors);
+ return true;
+}
 
 /* Initialize NDP-proxy */
 int ndp_init(void)
