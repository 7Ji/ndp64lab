FROM alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
ARG LAB_ID
COPY --from=repositories / /
LABEL org.ndp64lab.owner="$LAB_ID"
RUN apk add --no-cache ifupdown-ng iproute2 iputils busybox-extras tcpdump curl
COPY peer/entrypoint /usr/sbin/lab-peer
CMD ["/usr/sbin/lab-peer"]
