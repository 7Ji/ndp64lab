#!/bin/sh /etc/rc.common
START=95
USE_PROCD=1
start_service() {
 procd_open_instance
 procd_set_param command /bin/bash /usr/sbin/lab-register
 procd_set_param term_timeout 10
 procd_set_param respawn
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_set_param file /etc/config/network /etc/config/dhcp
 procd_close_instance
}
service_triggers() {
 procd_add_reload_trigger network dhcp
 procd_add_interface_trigger 'interface.*' '*' /etc/init.d/lab-ndp restart
}
reload_service() { stop; start; }
