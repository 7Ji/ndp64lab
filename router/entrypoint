#!/bin/sh
set -eu

while [ ! -s /lab/interfaces ]; do sleep 1; done

while read -r number mac; do
	found=
	for path in /sys/class/net/eth*; do
		if [ "$(cat "$path/address")" = "$mac" ]; then
			found=${path##*/}
			break
		fi
	done
	[ -n "$found" ] || { echo "missing interface for port $number ($mac)" >&2; exit 1; }
	ip link set dev "$found" down
	ip link set dev "$found" name "lab$number"
done < /lab/interfaces

for number in 0 1 2 3 4 5 6 7 8; do
	ip link set dev "lab$number" name "eth$number"
	ip link set dev "eth$number" up
done

exec /sbin/init
