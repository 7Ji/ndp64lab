config interface 'loopback'
	option ifname 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config interface 'wan'
	option ifname 'eth0'
	option proto 'static'
	option ipaddr '@ROUTER4@'
	option netmask '255.255.255.254'
	option gateway '@GATEWAY4@'
	option ip6addr '@ROUTER6@/128'
	option ip6gw '@GATEWAY6@'

config interface 'lan1'
	option ifname 'eth1'
	option ip6addr '@SHARED6@ff:1/64'
	option proto 'static'
	option ipaddr '192.168.1.1'
	option netmask '255.255.255.0'

config interface 'lan2'
	option ifname 'eth2'
	option ip6addr '@SHARED6@ff:2/64'
	option proto 'static'
	option ipaddr '192.168.2.1'
	option netmask '255.255.255.0'

config interface 'lan3'
	option ifname 'eth3'
	option ip6addr '@SHARED6@ff:3/64'
	option proto 'static'
	option ipaddr '192.168.3.1'
	option netmask '255.255.255.0'

config route6 'isp'
	option interface 'wan'
	option target '@ISP6@/128'

config route6 'unknown'
	option interface 'wan'
	option target '@SHARED6@/64'
	option type 'unreachable'
	option metric '1'

config registration 'registration'
	option isp_route 'isp'
