config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config interface 'wan'
	option device 'eth0'
	option proto 'static'
	option ipaddr '@ROUTER4@'
	option netmask '255.255.255.254'
	option gateway '@GATEWAY4@'
	option ip6addr '@ROUTER6@/128'
	option ip6gw '@GATEWAY6@'

