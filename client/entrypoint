#!/bin/sh
set -eu
# Managers own all client addressing. Docker's bootstrap IPv4 is discarded.
ip -4 addr flush dev eth0
ip -4 route flush dev eth0
sysctl -w net.ipv6.conf.all.forwarding=0 net.ipv6.conf.default.forwarding=0 \
    net.ipv6.conf.eth0.forwarding=0 net.ipv6.conf.eth0.disable_ipv6=0 \
    net.ipv6.conf.eth0.use_tempaddr=0 >/dev/null
case "$LAB_CLIENT_KIND" in
  networkd)
    mkdir -p /etc/systemd/network
    systemctl enable systemd-networkd.service
    systemctl disable NetworkManager.service
    exec /sbin/init
    ;;
  networkmanager)
    mkdir -p /etc/NetworkManager/system-connections /etc/NetworkManager/conf.d
    systemctl enable NetworkManager.service
    systemctl disable systemd-networkd.service
    exec /sbin/init
    ;;
  alpine)
    ifup eth0
    exec sleep infinity
    ;;
  *) echo "unknown client kind: $LAB_CLIENT_KIND" >&2; exit 1 ;;
esac
